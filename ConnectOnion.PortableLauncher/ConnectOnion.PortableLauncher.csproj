<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platforms>x86;x64;ARM64</Platforms>
    <RootNamespace>ConnectOnion.PortableLauncher</RootNamespace>
    <AssemblyName>ConnectOnion.WinUIClient</AssemblyName>
    <ApplicationIcon>..\ConnectOnion.WinUIClient\Assets\app-icon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- The solution build uses the ordinary SDK graph. The release workflow explicitly enables
         NativeAOT with its dedicated packages.publish.lock.json; keeping AOT off here prevents
         SDK-injected ILCompiler/ILLink packages from contaminating the normal solution lock. -->
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>
</Project>
