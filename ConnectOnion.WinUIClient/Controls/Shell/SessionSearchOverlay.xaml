<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.SessionSearchOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:models="using:ConnectOnion.WinUIClient.Models"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Visibility="Collapsed"
    IsHitTestVisible="False"
    IsTabStop="False">

    <Grid x:Name="OverlayRoot"
          KeyDown="OverlayRoot_KeyDown">
        <Rectangle Fill="{ThemeResource SettingsBackdropBrush}"
                   Tapped="Backdrop_Tapped" />

        <Border x:Name="ModalContainer"
                MaxWidth="560"
                MaxHeight="620"
                Margin="24,72,24,24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="{ThemeResource SettingsContentBrush}"
                BorderBrush="{ThemeResource SettingsModalBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Tapped="ModalContainer_Tapped"
                AutomationProperties.AutomationId="SessionSearchOverlay">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <Grid Padding="8,10,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Margin="2,0,2,8"
                        Padding="10,0"
                        CornerRadius="8"
                        Background="{ThemeResource SurfaceSecondaryBrush}"
                        BorderBrush="{ThemeResource BorderSubtleBrush}"
                        BorderThickness="1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ic:FluentIcon Icon="Search"
                                       IconVariant="Regular"
                                       IconSize="Size16"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBox x:Uid="SessionSearchInput"
                                 x:Name="SearchBox"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 PlaceholderText="Search chats"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyDown="SearchBox_KeyDown"
                                 AutomationProperties.AutomationId="SessionSearchBox"
                                 AutomationProperties.Name="Search chats" />
                    </Grid>
                </Border>

                <TextBlock x:Name="ShortTranscriptSearchHint"
                           x:Uid="SessionSearchShortTranscriptHint"
                           Grid.Row="1"
                           Text="Type at least 3 characters to search message text; chat titles and agent names still match now."
                           Margin="6,0,6,6"
                           FontSize="{StaticResource ProductCaptionFontSize}"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Polite" />

                <TextBlock x:Uid="SessionSearchChats"
                           Grid.Row="2"
                           Text="Chats"
                           Margin="6,2,6,4"
                           FontSize="{StaticResource ProductCaptionFontSize}"
                           Foreground="{ThemeResource TextTertiaryBrush}" />

                <Grid Grid.Row="3" MinHeight="80">
                    <ListView x:Name="ResultsList"
                              ItemsSource="{x:Bind Vm.Results, Mode=OneWay}"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="ResultsList_ItemClick"
                              KeyDown="ResultsList_KeyDown"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="SessionSearchResults">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="40" />
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SessionSearchItem">
                                <Grid ColumnSpacing="16"
                                      AutomationProperties.Name="{x:Bind AccessibilityName, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontSize="{StaticResource ProductBodyFontSize}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <!-- Present only when the transcript, not the title, is
                                             what matched — so the row can show why it came back.
                                             A title match needs no explanation. -->
                                        <TextBlock Text="{x:Bind Snippet, Mode=OneWay}"
                                                   FontSize="{StaticResource ProductCaptionFontSize}"
                                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   MaxLines="1"
                                                   Visibility="{x:Bind HasSnippet, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               MaxWidth="160"
                                               Text="{x:Bind AgentDisplayName}"
                                               FontSize="{StaticResource ProductCaptionFontSize}"
                                               Foreground="{ThemeResource TextTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="20,32"
                                Spacing="6">
                        <TextBlock x:Uid="SessionSearchEmpty"
                                   Text="No chats found"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Uid="SessionSearchEmptyHint"
                                   Text="Try a different search term."
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
