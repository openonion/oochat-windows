<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Uid="AddAgentRoot"
    x:Class="ConnectOnion.WinUIClient.Controls.AddAgentForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:ic="using:FluentIcons.WinUI"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Visibility="Collapsed"
    IsHitTestVisible="False"
    IsTabStop="False"
    AutomationProperties.Name="Add an agent"
    AutomationProperties.AutomationId="AddAgentOverlay">

    <Grid x:Name="OverlayRoot"
          KeyDown="OverlayRoot_KeyDown">
        <Rectangle Fill="{ThemeResource SettingsBackdropBrush}"
                   Tapped="Backdrop_Tapped" />

        <Border x:Name="ModalContainer"
                MaxWidth="460"
                MaxHeight="720"
                Margin="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="{ThemeResource SettingsContentBrush}"
                BorderBrush="{ThemeResource SettingsModalBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Tapped="ModalContainer_Tapped">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <ScrollViewer HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Stretch"
                          AutomationProperties.AutomationId="AddAgentFormScrollViewer">
            <StackPanel Padding="24"
                        Spacing="0">
                <TextBlock x:Uid="AddAgentTitle" Text="Add an agent"
                           FontSize="{StaticResource ProductTitleFontSize}"
                           FontWeight="SemiBold" />
                <TextBlock x:Uid="AddAgentIntro"
                           Margin="0,6,0,0"
                           Text="Paste the connection details from the agent's Share screen."
                           FontSize="{StaticResource ProductBodyFontSize}"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />

                <StackPanel Margin="0,20,0,0"
                            Spacing="8">
                    <TextBlock x:Uid="AddAgentAddressLabel" Text="Agent connection"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="InputBox"
                             x:Uid="AddAgentInput"
                             AutomationProperties.AutomationId="AgentAddressInput"
                             AutomationProperties.HelpText="{x:Bind LocalizedInputHelpText(Vm.ShowValidationError), Mode=OneWay}"
                             PlaceholderText="0x… or https://example.com/agent"
                             Text="{x:Bind Vm.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{x:Bind Vm.IsInputEnabled, Mode=OneWay}"
                             LostFocus="InputBox_LostFocus"
                             KeyDown="InputBox_KeyDown" />
                    <TextBlock x:Uid="AddAgentAddressHint"
                               Text="Use a 0x address for a shared relay agent, or an HTTP URL for a direct connection."
                               FontSize="{StaticResource ProductCaptionFontSize}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <!-- The form above assumes the user already holds an address. On a first run
                         nobody does, and there was nothing here pointing at where one comes
                         from — so this dialog was the end of the road for a new install. -->
                    <HyperlinkButton x:Uid="AddAgentWhereToGetOne"
                                     Content="Where do I get an agent address?"
                                     Padding="0,2"
                                     FontSize="{StaticResource ProductCaptionFontSize}"
                                     AutomationProperties.AutomationId="AddAgentDocsLink"
                                     Click="AddAgentDocs_Click" />
                    <TextBlock x:Uid="AddAgentHostDocsHint"
                               Text="Run your agent with host(agent) and copy the 0x address shown in the terminal, or enter the HTTP URL of a deployed agent."
                               FontSize="{StaticResource ProductMicroFontSize}"
                               Foreground="{ThemeResource TextTertiaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Uid="AddAgentAddressError" Text="Enter a valid agent address or HTTP URL."
                               FontSize="{StaticResource ProductCaptionFontSize}"
                               Foreground="{ThemeResource DangerBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Visibility="{x:Bind Vm.ShowValidationError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <Expander x:Uid="AddAgentAppearance"
                          AutomationProperties.AutomationId="AgentAppearanceExpander"
                          Margin="0,16,0,0"
                          Header="Customize appearance (optional)"
                          IsExpanded="False">
                    <StackPanel Spacing="8"
                                Padding="0,8,0,0">

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Previews the uncommitted temporary file: AgentAvatar accepts an
                             absolute path as long as it is inside the managed directories, which
                             is what lets the user see the pick before the agent exists. -->
                        <controls:AgentAvatar x:Uid="AddAgentIconPreview" x:Name="AvatarPreview"
                                              Grid.Column="0"
                                              Size="72"
                                              CornerRadius="36"
                                              FontSize="{StaticResource ProductHeroFontSize}"
                                              VerticalAlignment="Top"
                                              Initial="?"
                                              AutomationProperties.Name="Agent icon preview" />

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <Button x:Name="ChooseIconButton" AutomationProperties.AutomationId="ChooseIconButton"
                                        x:Uid="AddAgentChooseIcon"
                                        MinWidth="112"
                                        Height="36"
                                        Content="Choose image"
                                        Click="ChooseIcon_Click"
                                        AutomationProperties.Name="Choose an agent icon" />

                                <Button x:Name="RemoveIconButton" AutomationProperties.AutomationId="RemoveIconButton"
                                        x:Uid="AddAgentRemoveIcon"
                                        Height="36"
                                        Content="Remove"
                                        Click="RemoveIcon_Click"
                                        Visibility="Collapsed"
                                        AutomationProperties.Name="Remove the selected agent icon" />

                                <ProgressRing x:Name="IconProgressRing"
                                              Width="18"
                                              Height="18"
                                              Margin="4,0,0,0"
                                              VerticalAlignment="Center"
                                              IsActive="False"
                                              Visibility="Collapsed" />
                            </StackPanel>

                            <TextBlock x:Uid="AddAgentIconHint"
                                       Text="Optional. PNG, JPG, JPEG or WebP, up to 5 MB."
                                       FontSize="{StaticResource ProductCaptionFontSize}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="IconErrorText"
                                       FontSize="{StaticResource ProductCaptionFontSize}"
                                       Foreground="{ThemeResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </Expander>

                <Grid Margin="0,16,0,0"
                      MinHeight="40"
                      ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="TestButton" AutomationProperties.AutomationId="TestButton"
                            MinWidth="130"
                            Height="40"
                            HorizontalAlignment="Left"
                            IsEnabled="{x:Bind Vm.CanTest, Mode=OneWay}"
                            Click="TestConnection_Click"
                            AutomationProperties.Name="{x:Bind LocalizedTestButtonText(Vm.IsTesting), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <ProgressRing Width="16"
                                          Height="16"
                                          IsActive="{x:Bind Vm.IsTesting, Mode=OneWay}"
                                          Visibility="{x:Bind Vm.IsTesting, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{x:Bind LocalizedTestButtonText(Vm.IsTesting), Mode=OneWay}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Grid Grid.Column="1"
                          MinHeight="40"
                          VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="7"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind Vm.ShowTestingStatus, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <ProgressRing Width="14"
                                          Height="14"
                                          IsActive="{x:Bind Vm.IsTesting, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind LocalizedStatusText(Vm.StatusText), Mode=OneWay}"
                                       FontSize="{StaticResource ProductCaptionFontSize}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="7"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind Vm.ShowConnected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <ic:FluentIcon x:Uid="AddAgentConnectionOk" Icon="CheckmarkCircle"
                                           IconVariant="Regular"
                                           IconSize="Size16"
                                           Foreground="{ThemeResource SuccessBrush}"
                                           AutomationProperties.Name="Connection successful" />
                            <TextBlock Text="{x:Bind LocalizedStatusText(Vm.StatusText), Mode=OneWay}"
                                       FontSize="{StaticResource ProductCaptionFontSize}"
                                       Foreground="{ThemeResource SuccessBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="7"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind Vm.ShowConnectionError, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <ic:FluentIcon x:Uid="AddAgentConnectionFailed" Icon="ErrorCircle"
                                           IconVariant="Regular"
                                           IconSize="Size16"
                                           Foreground="{ThemeResource DangerBrush}"
                                           AutomationProperties.Name="Connection failed" />
                            <TextBlock Text="{x:Bind LocalizedStatusText(Vm.StatusText), Mode=OneWay}"
                                       FontSize="{StaticResource ProductCaptionFontSize}"
                                       Foreground="{ThemeResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <StackPanel Margin="0,24,0,0"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right">
                    <Button x:Uid="AddAgentCancel" Width="96"
                            Height="40"
                            Content="Cancel"
                            Click="Cancel_Click"
                            AutomationProperties.Name="Cancel adding agent" />
                    <Button MinWidth="116"
                            MaxWidth="116"
                            Height="40"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind Vm.CanAdd, Mode=OneWay}"
                            Click="AddAgent_Click"
                            AutomationProperties.AutomationId="SubmitAgentButton"
                            AutomationProperties.Name="{x:Bind LocalizedAddButtonText(Vm.IsAdding), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <ProgressRing Width="16"
                                          Height="16"
                                          IsActive="{x:Bind Vm.IsAdding, Mode=OneWay}"
                                          Visibility="{x:Bind Vm.IsAdding, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{x:Bind LocalizedAddButtonText(Vm.IsAdding), Mode=OneWay}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
