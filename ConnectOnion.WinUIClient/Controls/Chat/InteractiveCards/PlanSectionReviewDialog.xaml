<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Uid="PlanSectionReviewDialog"
    x:Class="ConnectOnion.WinUIClient.Controls.PlanSectionReviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectOnion.WinUIClient.Controls"
    Title="Review plan by section"
    PrimaryButtonText="Approve plan"
    SecondaryButtonText="Request changes"
    CloseButtonText="Cancel"
    DefaultButton="Primary">
    <ContentDialog.Resources>
        <!-- LOAD-BEARING. ContentDialogMaxWidth defaults to 548, and ApplyResponsiveSize gives the
             content grid an explicit width of up to MaxContentWidth (620). An explicit width wider
             than the dialog does not widen the dialog — the content overflows it and is clipped on
             the right, silently. That is what cut off the right edge of every section's markdown
             ("(Ubuntu 22.04/24.04, Linux 6.8.0-124-gene…") and left the feedback box with its whole
             right padding missing. Raising the dialog's own ceiling is what lets the width the code
             asks for actually exist; keep this above MaxContentWidth + ContentDialogPadding. -->
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>
    <Grid x:Name="ContentGrid"
          MinWidth="320"
          MinHeight="240">
        <ListView x:Uid="PlanSectionList" ItemsSource="{x:Bind Sections}"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  Padding="0"
                  HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="Plan sections">
            <!-- HorizontalContentAlignment on the ListView does not reach its generated
                 ListViewItems in WinUI; without this setter each container sizes to its content's
                 desired width instead of the viewport, so one wide line (a table, a long inline
                 code span) pushes the whole card past the right edge. Same pattern as
                 ChatPage.xaml's transcript list. -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PlanReviewSectionItem">
                    <Border Margin="0,0,0,10"
                            Padding="14"
                            CornerRadius="10"
                            BorderBrush="{ThemeResource BorderDefaultBrush}"
                            BorderThickness="1"
                            Background="{ThemeResource SurfaceSecondaryBrush}">
                        <StackPanel Spacing="9">
                            <TextBlock Text="{x:Bind Heading}"
                                       FontSize="{StaticResource ProductSubtitleFontSize}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" />
                            <local:MarkdownTextBlock Markdown="{x:Bind Markdown}"
                                                     FontSize="{StaticResource ProductBodyFontSize}"
                                                     AutomationProperties.Name="{x:Bind Heading}" />
                            <Grid ColumnSpacing="8"
                                  Visibility="{x:Bind IsReadOnly, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton Tag="{x:Bind}"
                                             MinHeight="40"
                                             HorizontalAlignment="Stretch"
                                             IsChecked="{x:Bind IsApproved, Mode=OneWay}"
                                             Click="ApproveSection_Click"
                                             AutomationProperties.Name="{x:Bind ApproveAccessibilityName}">
                                    <TextBlock x:Uid="PlanSectionLooksGoodText" Text="Looks good" TextWrapping="Wrap" />
                                </RadioButton>
                                <RadioButton Grid.Column="1"
                                             Tag="{x:Bind}"
                                             MinHeight="40"
                                             HorizontalAlignment="Stretch"
                                             IsChecked="{x:Bind NeedsChanges, Mode=OneWay}"
                                             Click="RequestSectionChanges_Click"
                                             AutomationProperties.Name="{x:Bind ChangesAccessibilityName}">
                                    <TextBlock x:Uid="PlanSectionNeedsChangesText" Text="Needs changes" TextWrapping="Wrap" />
                                </RadioButton>
                            </Grid>
                            <TextBox x:Uid="PlanSectionFeedback" Text="{x:Bind Feedback, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Optional feedback for this section…"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="48"
                                     MaxHeight="120"
                                     Visibility="{x:Bind IsReadOnly, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                     AutomationProperties.Name="{x:Bind FeedbackAccessibilityName}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
