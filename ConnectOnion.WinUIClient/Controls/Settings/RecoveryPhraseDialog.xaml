<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Uid="RecoveryPhraseDialog" x:Class="ConnectOnion.WinUIClient.Controls.RecoveryPhraseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    CloseButtonText="Close"
    AutomationProperties.AutomationId="RecoveryPhraseDialog"
    DefaultButton="Primary">

    <ScrollViewer MaxHeight="520" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MinWidth="0" Width="440">

            <!-- The warning leads, because the phrase itself is below it and reading order is
                 the only thing standing between a user and pasting it into a chat window. -->
            <Border Background="{ThemeResource DangerSubtleBrush}" CornerRadius="8" Padding="12,10">
                <!-- A Grid, not a horizontal StackPanel: a StackPanel measures its children with
                     infinite width on the stacking axis, so TextWrapping never triggers and the
                     warning is silently clipped at the border. -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ic:FluentIcon Grid.Column="0" Icon="Warning" IconVariant="Regular" IconSize="Size16"
                                   Foreground="{ThemeResource DangerBrush}" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" x:Name="WarningText" TextWrapping="Wrap" MinWidth="0"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
            </Border>

            <TextBlock x:Name="IntroText" TextWrapping="Wrap" MinWidth="0"
                       Foreground="{ThemeResource TextSecondaryBrush}" />

            <!-- Phrase identities: the numbered word grid. Numbered because the order is part of
                 the secret — a correct set of words in the wrong order restores nothing. -->
            <!-- Visibility rather than x:Load: only one of these two blocks is ever shown and both
                 are a handful of elements, so deferral would buy nothing and cost a realization
                 path to get wrong. -->
            <ItemsRepeater x:Name="WordsRepeater" Visibility="Collapsed">
                <ItemsRepeater.Layout>
                    <!-- 46px clipped JetBrains Mono descenders (p/g/y); room for caption + body + pad. -->
                    <UniformGridLayout MinItemWidth="130" MinItemHeight="58"
                                       MinColumnSpacing="8" MinRowSpacing="8"
                                       ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="controls:RecoveryPhraseWord">
                        <Border Background="{ThemeResource SurfaceSecondaryBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Position}"
                                           FontSize="{StaticResource ProductCaptionFontSize}"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Word}" IsTextSelectionEnabled="True"
                                           FontFamily="{StaticResource JetBrainsMonoFontFamily}"
                                           FontSize="{StaticResource ProductBodyFontSize}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Pre-phrase identities: the raw seed is all they have, so it is shown in full
                 rather than hidden behind a format this dialog cannot produce. -->
            <Border x:Name="SeedBlock" Visibility="Collapsed"
                    Background="{ThemeResource SurfaceSecondaryBrush}"
                    BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,10">
                <TextBlock x:Name="SeedText" TextWrapping="Wrap" MinWidth="0" IsTextSelectionEnabled="True"
                           FontFamily="{StaticResource JetBrainsMonoFontFamily}" />
            </Border>

            <Button x:Name="CopyButton" AutomationProperties.AutomationId="CopyButton" Click="Copy_Click" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:FluentIcon Icon="Copy" IconVariant="Regular" IconSize="Size16" />
                            <TextBlock x:Uid="RecoveryCopy" x:Name="CopyButtonText" Text="Copy" />
                </StackPanel>
            </Button>
            <TextBlock x:Uid="RecoveryPhraseClipboardNotice"
                       Text="Copies stay off clipboard history and are cleared after 60 seconds."
                       FontSize="{StaticResource ProductCaptionFontSize}"
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />

            <!-- Restoring to the wrong address is the failure this catches: the user can compare
                 what they wrote down against the address the phrase actually belongs to. -->
            <StackPanel Spacing="2">
                    <TextBlock x:Uid="RecoveryBelongsTo" Text="Belongs to address" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
                <TextBlock x:Name="AddressText" TextWrapping="Wrap" MinWidth="0" IsTextSelectionEnabled="True"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontFamily="{StaticResource JetBrainsMonoFontFamily}"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
