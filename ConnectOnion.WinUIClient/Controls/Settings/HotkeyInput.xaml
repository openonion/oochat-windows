<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.HotkeyInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button x:Name="CaptureButton" AutomationProperties.AutomationId="CaptureButton"
            MinWidth="150"
            HorizontalContentAlignment="Center"
            Click="CaptureButton_Click"
            PreviewKeyDown="CaptureButton_PreviewKeyDown"
            LostFocus="CaptureButton_LostFocus">
        <TextBlock x:Name="ChordText"
                   FontFamily="{StaticResource JetBrainsMonoFontFamily}"
                   FontSize="{StaticResource ProductCaptionFontSize}"
                   TextAlignment="Center" />
    </Button>
</UserControl>
