<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.AgentsSettingsContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:models="using:ConnectOnion.WinUIClient.Models">

    <StackPanel Spacing="16">
        <TextBlock x:Uid="AgentsSettingsDescription" Text="Manage the agents connected to this device. Removing an agent also removes its local conversations."
                   Foreground="{ThemeResource TextSecondaryBrush}"
                   TextWrapping="WrapWholeWords" />

        <Border x:Name="AgentListCard"
                Style="{StaticResource CardBorderStyle}"
                Padding="0"
                AutomationProperties.AutomationId="SettingsAgentList">
            <StackPanel>
                <ItemsControl ItemsSource="{x:Bind Agents, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ShellAgentItem">
                            <Grid MinHeight="76"
                                  Padding="16,10"
                                  ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="38"
                                      Height="38"
                                      VerticalAlignment="Center">
                                    <controls:AgentAvatar Size="38"
                                                          CornerRadius="19"
                                                          FontSize="{StaticResource ProductBodyFontSize}"
                                                          Initial="{x:Bind Initial}"
                                                          ImagePath="{x:Bind IconPath}" />
                                    <Ellipse Width="9"
                                             Height="9"
                                             Margin="0,0,-2,-2"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Bottom"
                                             Fill="{x:Bind Presence, Mode=OneWay, Converter={StaticResource PresenceToBrush}}"
                                             Stroke="{ThemeResource SurfaceElevatedBrush}"
                                             StrokeThickness="2"
                                             AutomationProperties.Name="{x:Bind PresenceLabel, Mode=OneWay}" />
                                </Grid>

                                <StackPanel Grid.Column="1"
                                            MinWidth="0"
                                            VerticalAlignment="Center"
                                            Spacing="3">
                                    <TextBlock Text="{x:Bind DisplayName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ConnectionTarget}"
                                               FontFamily="{StaticResource JetBrainsMonoFontFamily}"
                                               FontSize="{StaticResource ProductCaptionFontSize}"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind ConnectionTarget}" />
                                </StackPanel>

                                <Button x:Uid="AgentSettingsRenameAgent" Grid.Column="2"
                                        Width="36"
                                        Height="36"
                                        Style="{StaticResource SmallIconButtonStyle}"
                                        Tag="{x:Bind Id}"
                                        Click="RenameAgent_Click"
                                        AutomationProperties.AutomationId="RenameAgentButton"
                                        AutomationProperties.Name="Rename agent"
                                        ToolTipService.ToolTip="Rename agent">
                                    <ic:FluentIcon Icon="Edit"
                                                   IconVariant="Regular"
                                                   IconSize="Size16"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                </Button>

                                <Button x:Uid="AgentSettingsCopyAddress" Grid.Column="3"
                                        Width="36"
                                        Height="36"
                                        Style="{StaticResource SmallIconButtonStyle}"
                                        Tag="{x:Bind ConnectionTarget}"
                                        Click="CopyAgent_Click"
                                        AutomationProperties.Name="{x:Bind CopyAccessibilityName}"
                                        ToolTipService.ToolTip="Copy agent address">
                                    <ic:FluentIcon Icon="Copy"
                                                   IconVariant="Regular"
                                                   IconSize="Size16"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                </Button>

                                <Button x:Uid="AgentSettingsDeleteAgent" Grid.Column="4"
                                        Width="36"
                                        Height="36"
                                        Style="{StaticResource SmallIconButtonStyle}"
                                        Tag="{x:Bind Id}"
                                        Click="DeleteAgent_Click"
                                        AutomationProperties.Name="{x:Bind DeleteAccessibilityName}"
                                        ToolTipService.ToolTip="Delete agent">
                                    <ic:FluentIcon Icon="Delete"
                                                   IconVariant="Regular"
                                                   IconSize="Size16"
                                                   Foreground="{ThemeResource DangerBrush}" />
                                </Button>

                                <Rectangle Grid.ColumnSpan="5"
                                           Height="1"
                                           Margin="0,0,0,-10"
                                           VerticalAlignment="Bottom"
                                           Fill="{ThemeResource DividerBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Padding="16,12"
                      ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="AgentsSettingsConnectAnother" VerticalAlignment="Center"
                               Text="Connect another agent to start new conversations."
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />
                    <Button x:Uid="SettingsAgentsAddButton" Grid.Column="1"
                            MinWidth="112"
                            Height="40"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="AddAgent_Click"
                            AutomationProperties.AutomationId="SettingsAddAgentButton"
                            AutomationProperties.Name="Add agent">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <ic:FluentIcon Icon="Add"
                                           IconVariant="Regular"
                                           IconSize="Size16" />
                            <TextBlock x:Uid="AgentsSettingsAdd" Text="Add agent" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel x:Name="EmptyState"
                    Padding="20,28"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <ic:FluentIcon Icon="Bot"
                           IconVariant="Regular"
                           IconSize="Size24"
                           Foreground="{ThemeResource TextTertiaryBrush}" />
            <TextBlock x:Uid="AgentsSettingsEmpty" Text="No agents connected"
                       FontWeight="SemiBold"
                       TextAlignment="Center" />
            <TextBlock x:Uid="AgentsSettingsEmptyHint" Text="Add an agent to start a conversation."
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       TextAlignment="Center" />
            <Button x:Uid="SettingsAgentsAddButton" Height="40"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="AddAgent_Click"
                    AutomationProperties.Name="Add agent">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <ic:FluentIcon Icon="Add"
                                   IconVariant="Regular"
                                   IconSize="Size16" />
                    <TextBlock x:Uid="AgentsSettingsAdd" Text="Add agent" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
