<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.KeyboardSettingsContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:common="using:ConnectOnion.WinUIClient.Common"
    xmlns:vm="using:ConnectOnion.WinUIClient.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <common:KeyboardTextConverter x:Key="KeyboardText" />
    </UserControl.Resources>

    <StackPanel Spacing="14">
        <!-- Search is local to this list rather than the overlay's own settings search: it filters
             shortcut rows, not setting cards, and the two would fight over one box. -->
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Uid="KeyboardSearch" x:Name="SearchBox" AutomationProperties.AutomationId="SearchBox"
                     PlaceholderText="Search shortcuts"
                     TextChanged="SearchBox_TextChanged"
                     AutomationProperties.Name="Search shortcuts" />
            <Button x:Uid="KeyboardResetAll" Grid.Column="1"
                    x:Name="ResetAllButton" AutomationProperties.AutomationId="ResetAllButton"
                    Content="Reset all"
                    Click="ResetAll_Click"
                    IsEnabled="{x:Bind Vm.HasAnyRebinding, Mode=OneWay}"
                    AutomationProperties.Name="Reset all shortcuts to their defaults" />
        </Grid>

        <TextBlock x:Uid="KeyboardNoMatches" Text="No shortcuts match your search."
                   Foreground="{ThemeResource TextSecondaryBrush}"
                   Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay}" />

        <ItemsControl ItemsSource="{x:Bind Vm.Groups, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KeyboardShortcutRowGroup">
                    <StackPanel Margin="0,6,0,14" Spacing="6">
                        <TextBlock Text="{x:Bind Title, Converter={StaticResource KeyboardText}}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                        <ItemsControl ItemsSource="{x:Bind Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:KeyboardShortcutRow">
                                    <controls:KeyboardShortcutEditorRow Row="{x:Bind}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
