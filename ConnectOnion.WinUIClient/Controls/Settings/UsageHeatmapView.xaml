<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.UsageHeatmapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ConnectOnion.WinUIClient.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Square geometry lives in one place: the month-label strip and the weekday gutter are
             positioned by hand from these, so a change to CellSize that missed one of them would
             shear the labels away from the columns they name. -->
        <x:Double x:Key="HeatmapCellSize">11</x:Double>
        <x:Double x:Key="HeatmapCellStride">13</x:Double>

        <!-- One square. A Button, not a Border, because the design requires hover *and* keyboard
             focus to reveal a day: Border is not focusable and cannot carry a tooltip target that
             a keyboard user can reach. The template is stripped to a single Rectangle so the
             control costs about what a Border would. -->
        <Style x:Key="HeatmapDayStyle" TargetType="Button">
            <Setter Property="Width" Value="{StaticResource HeatmapCellSize}" />
            <Setter Property="Height" Value="{StaticResource HeatmapCellSize}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="Fill"
                                       RadiusX="2" RadiusY="2"
                                       Fill="{TemplateBinding Background}" />
                            <!-- Hover is a stroke rather than a fill change: re-tinting the square
                                 would misreport the day's value for as long as the pointer sits
                                 on it, which is the one thing this control must never do. -->
                            <Rectangle x:Name="HoverRing"
                                       RadiusX="2" RadiusY="2"
                                       Opacity="0"
                                       Stroke="{ThemeResource TextPrimaryBrush}"
                                       StrokeThickness="1" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.85" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One legend swatch. Static, non-interactive: the legend explains the scale, it is not
             a filter, so it must not look clickable or take a tab stop. -->
        <Style x:Key="HeatmapLegendSwatchStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="{StaticResource HeatmapCellSize}" />
            <Setter Property="Height" Value="{StaticResource HeatmapCellSize}" />
            <Setter Property="RadiusX" Value="2" />
            <Setter Property="RadiusY" Value="2" />
        </Style>
    </UserControl.Resources>

    <!-- No AutomationId on this root: a UserControl/Panel produces no automation peer, so the id
         would be unfindable and would only mislead the next person writing a UI test. The day
         squares are Buttons and carry the accessibility contract (see their AutomationProperties
         .Name below); ShellSmokeTests asserts against those. -->
    <StackPanel Spacing="10">

        <!-- Header: the count carries the meaning, the range is the caption under it. -->
        <StackPanel Spacing="2">
            <TextBlock x:Name="SummaryText"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Foreground="{ThemeResource TextPrimaryBrush}" />
            <TextBlock x:Name="RangeText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- The grid scrolls horizontally on its own. A year of weeks does not fit a narrow
             Settings pane, and the page body must never scroll sideways (see CLAUDE.md) — so the
             overflow is contained here rather than pushed out to the panel. -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Auto"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Weekday gutter. Only Mon/Wed/Fri are labelled, as the design specifies:
                     naming all seven turns the gutter into a wall of text next to squares that
                     are 11px tall. Positioned by row index x stride in code-behind. -->
                <Canvas x:Name="WeekdayGutter"
                        Grid.Row="1" Grid.Column="0"
                        Width="30" />

                <!-- Month strip, laid out in code-behind at each month's starting column. -->
                <Canvas x:Name="MonthStrip"
                        Grid.Row="0" Grid.Column="1"
                        Height="16" />

                <!-- The squares. UniformGridLayout with Orientation="Vertical" and 7 rows flows
                     items top-to-bottom then wraps to the next column, which is exactly GitHub's
                     layout — and is why UsageHeatmap.Days is ordered column-major. -->
                <ItemsRepeater x:Name="DayRepeater"
                               Grid.Row="1" Grid.Column="1">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Vertical"
                                           MaximumRowsOrColumns="7"
                                           MinItemWidth="{StaticResource HeatmapCellSize}"
                                           MinItemHeight="{StaticResource HeatmapCellSize}"
                                           MinRowSpacing="2"
                                           MinColumnSpacing="2" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:UsageHeatmapDay">
                            <Button Style="{StaticResource HeatmapDayStyle}"
                                    Background="{x:Bind Level, Converter={StaticResource HeatmapLevelToBrush}}"
                                    Visibility="{x:Bind IsInRange, Converter={StaticResource BoolToVis}}"
                                    ToolTipService.ToolTip="{x:Bind Description}"
                                    AutomationProperties.Name="{x:Bind Description}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>

        <!-- Legend, right-aligned under the grid. -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="4"
                    VerticalAlignment="Center">
            <TextBlock x:Uid="UsageHeatmapLess" Text="Less"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,2,0" />
            <Rectangle Style="{StaticResource HeatmapLegendSwatchStyle}" Fill="{ThemeResource HeatmapLevel0Brush}" />
            <Rectangle Style="{StaticResource HeatmapLegendSwatchStyle}" Fill="{ThemeResource HeatmapLevel1Brush}" />
            <Rectangle Style="{StaticResource HeatmapLegendSwatchStyle}" Fill="{ThemeResource HeatmapLevel2Brush}" />
            <Rectangle Style="{StaticResource HeatmapLegendSwatchStyle}" Fill="{ThemeResource HeatmapLevel3Brush}" />
            <Rectangle Style="{StaticResource HeatmapLegendSwatchStyle}" Fill="{ThemeResource HeatmapLevel4Brush}" />
            <TextBlock x:Uid="UsageHeatmapMore" Text="More"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="2,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
