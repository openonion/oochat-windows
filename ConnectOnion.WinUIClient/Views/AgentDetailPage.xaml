<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ConnectOnion.WinUIClient.Views.AgentDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="AgentRoot"
          Background="{ThemeResource AppBackgroundBrush}"
          SizeChanged="AgentRoot_SizeChanged">

        <Grid.Resources>
            <!-- One quiet caption run for the profile's metadata line. Status, model, version
                 and tool count read as a single sentence. -->
            <Style x:Key="ProfileMetaTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource ProductCaptionFontSize}" />
                <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </Grid.Resources>

        <!-- Driven by the page's own SizeChanged rather than AdaptiveTrigger: the content pane is
             up to 288px narrower than the window once the sidebar is open, so a MinWindowWidth
             trigger switched this page to its roomier padding while it actually had ~430px. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="ContentScroll.Padding" Value="{StaticResource AgentDetailPaddingNarrow}" />
                        <Setter Target="AgentDetailAvatar.Size" Value="48" />
                        <Setter Target="AgentDetailAvatar.FontSize" Value="{StaticResource ProductSectionTitleFontSize}" />
                        <Setter Target="AgentDetailAvatar.CornerRadius" Value="16" />
                        <Setter Target="AgentNameText.FontSize" Value="{StaticResource ProductTitleFontSize}" />
                        <Setter Target="AgentNameText.Margin" Value="0,12,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.Setters>
                        <Setter Target="ContentScroll.Padding" Value="{StaticResource AgentDetailPaddingWide}" />
                        <!-- Larger identity mark on tall/wide panes; type stays on the Product ramp. -->
                        <Setter Target="AgentDetailAvatar.Size" Value="64" />
                        <Setter Target="AgentDetailAvatar.FontSize" Value="{StaticResource ProductSectionTitleFontSize}" />
                        <Setter Target="AgentDetailAvatar.CornerRadius" Value="20" />
                        <Setter Target="AgentNameText.FontSize" Value="{StaticResource ProductTitleFontSize}" />
                        <Setter Target="AgentNameText.Margin" Value="0,16,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Equal star rows centre the identity block in the pane above the composer. Star rows
             still collapse when height is tight. -->
        <ScrollViewer x:Name="ContentScroll"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto"
                      VerticalContentAlignment="Stretch"
                      Visibility="{x:Bind Vm.HasAgent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

            <!-- Two tiers: identity, then one line of facts about it -->
            <StackPanel x:Name="ProfilePanel"
                        Grid.Row="1"
                        MaxWidth="560"
                        HorizontalAlignment="Center"
                        Spacing="0">

                <!-- Tier 1 · Identity. Agent icon and name underneath -->
                <controls:AgentAvatar x:Name="AgentDetailAvatar"
                                      x:Uid="AgentDetailIcon"
                                      Size="64"
                                      CornerRadius="20"
                                      FontSize="{StaticResource ProductSectionTitleFontSize}"
                                      HorizontalAlignment="Center"
                                      Initial="{x:Bind Vm.AgentInitial, Mode=OneWay}"
                                      ImagePath="{x:Bind Vm.AgentIconPath, Mode=OneWay}"
                                      AutomationProperties.Name="Agent icon" />

                <TextBlock x:Name="AgentNameText"
                           Text="{x:Bind Vm.AgentDisplayName, Mode=OneWay}"
                           Margin="0,16,0,0"
                           FontSize="{StaticResource ProductTitleFontSize}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Tier 2 · Metadata line: "● Online · {model} · v{ver} · {n} tools". -->
                <StackPanel Orientation="Horizontal"
                            MinHeight="32"
                            Margin="0,8,0,0"
                            Spacing="6"
                            HorizontalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind Vm.AcceptedInputsSummary, Mode=OneWay}">
                
                <!-- Online/Offline status -->
                <Grid Width="12" Height="12" VerticalAlignment="Center">
                    <ProgressRing Width="12"
                                  Height="12"
                                  MinWidth="0"
                                  MinHeight="0"
                                  IsActive="{x:Bind Vm.IsCheckingPresence, Mode=OneWay}"
                                  Visibility="{x:Bind Vm.IsCheckingPresence, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Ellipse Width="7"
                             Height="7"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Fill="{x:Bind Vm.Presence, Mode=OneWay, Converter={StaticResource PresenceToBrush}}"
                             Visibility="{x:Bind Vm.IsCheckingPresence, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                </Grid>
                <TextBlock Text="{x:Bind Vm.PresenceLabel, Mode=OneWay}"
                            Style="{StaticResource ProfileMetaTextStyle}"
                            Foreground="{x:Bind Vm.Presence, Mode=OneWay, Converter={StaticResource PresenceToBrush}}"
                            AutomationProperties.LiveSetting="Polite" />
                
                <!-- Model -->
                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            Visibility="{x:Bind Vm.HasDisplayModel, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="·" Style="{StaticResource ProfileMetaTextStyle}" />
                    <TextBlock Text="{x:Bind Vm.DisplayModel, Mode=OneWay}"
                                MaxWidth="200"
                                Style="{StaticResource ProfileMetaTextStyle}" />
                </StackPanel>

                <!-- Version -->
                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            Visibility="{x:Bind Vm.HasProfileDetail, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="·" Style="{StaticResource ProfileMetaTextStyle}" />
                    <TextBlock Text="{x:Bind Vm.ProfileDetail, Mode=OneWay}"
                                Style="{StaticResource ProfileMetaTextStyle}" />
                </StackPanel>

                <!-- Tools -->
                <StackPanel Orientation="Horizontal"
                            Spacing="2"
                            Visibility="{x:Bind Vm.HasProfileDetail, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="·" Style="{StaticResource ProfileMetaTextStyle}" />
                    <Button MinWidth="0"
                            MinHeight="28"
                            Padding="4,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource TransparentButtonStyle}"
                            UseSystemFocusVisuals="True"
                            AutomationProperties.Name="{x:Bind Vm.ToolsToggleLabel, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Vm.ToolsToggleLabel, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind Vm.ToolsToggleLabel, Mode=OneWay}"
                                       Style="{StaticResource ProfileMetaTextStyle}" />
                            <ic:FluentIcon Icon="ChevronDown"
                                           IconVariant="Regular"
                                           IconSize="Size12"
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Width="420"
                                            MaxWidth="520"
                                            Spacing="8">
                                    <TextBlock x:Uid="AgentDetailTools" Text="Available tools"
                                               FontSize="{StaticResource ProductBodyFontSize}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Vm.ToolsDisplayText, Mode=OneWay}"
                                               FontSize="{StaticResource ProductBodyFontSize}"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="{x:Bind Vm.ToolsDisplayText, Mode=OneWay}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
            </StackPanel>

            <!-- Suggestions are on here and nowhere else: this is the agent's landing surface, the one
             moment a user has nothing typed and no idea what to ask for. The agent's usable skill
             offers come first, and generic starters fill the row to three. -->
            <controls:ChatComposer x:Name="Composer"
                                Grid.Row="2"
                                Margin="0,24,0,0"
                                HorizontalAlignment="Stretch"
                                CanSubmit="{x:Bind Vm.CanStartConversation, Mode=OneWay}"
                                EnterToSubmit="{x:Bind Vm.EnterToSend, Mode=OneWay}"
                                AcceptedInputs="{x:Bind Vm.AcceptedInputs, Mode=OneWay}"
                                Skills="{x:Bind Vm.Skills, Mode=OneWay}"
                                PlaceholderText="{x:Bind Vm.ComposerPlaceholder, Mode=OneWay}"
                                ShowSuggestions="True"
                                SuggestionPrompts="{x:Bind Vm.SkillOffers, Mode=OneWay}"
                                ShowModeSelector="True"
                                Mode="{x:Bind Vm.CurrentMode, Mode=OneWay}"
                                ModeChangeRequested="Composer_ModeChangeRequested"
                                SubmitRequested="Composer_SubmitRequested"
                                Visibility="{x:Bind Vm.HasAgent, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            
            <StackPanel Grid.Row="3"
                            MaxWidth="620"
                            Margin="24,4,24,0"
                            VerticalAlignment="Top"
                            Spacing="12">
                <ProgressRing x:Uid="AgentDetailCapabilitiesProgress" Width="18"
                              Height="18"
                              Margin="0,14,0,0"
                              HorizontalAlignment="Center"
                              AutomationProperties.AutomationId="AgentCapabilitiesLoadingIndicator"
                              AutomationProperties.Name="Loading agent capabilities"
                              IsActive="{x:Bind Vm.IsLoading, Mode=OneWay}"
                              Visibility="{x:Bind Vm.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <InfoBar x:Uid="AgentDetailStartError" Severity="Error"
                         Title="Couldn't start the conversation"
                         Message="{x:Bind Vm.StatusText, Mode=OneWay}"
                         IsOpen="{x:Bind Vm.HasError, Mode=OneWay}"
                         Visibility="{x:Bind Vm.HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                         IsClosable="False"
                         AutomationProperties.LiveSetting="Assertive" />

                <controls:OfflineNoticeBar HorizontalAlignment="Stretch"
                                           Detail="{x:Bind Vm.PresenceDetail, Mode=OneWay}"
                                           CanRecheck="{x:Bind Vm.HasAgent, Mode=OneWay}"
                                           IsChecking="{x:Bind Vm.IsCheckingPresence, Mode=OneWay}"
                                           StatusMessage="{x:Bind Vm.RecheckFailedMessage, Mode=OneWay}"
                                           RecheckRequested="OfflineNotice_RecheckRequested"
                                           Visibility="{x:Bind Vm.ShowOfflineNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <animations:Implicit.ShowAnimations>
                        <animations:OpacityAnimation From="0"
                                                     To="1"
                                                     Duration="0:0:0.2" />
                        <animations:TranslationAnimation From="0,-6,0"
                                                         To="0,0,0"
                                                         Duration="0:0:0.2" />
                    </animations:Implicit.ShowAnimations>
                </controls:OfflineNoticeBar>
            </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- Page-level actions (Share etc.) sit in the top right corner, out of the new-chat flow -->
        <StackPanel Orientation="Horizontal"
                    Margin="16"
                    Spacing="{StaticResource Spacing4}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">

            <!--<Button x:Uid="AgentDetailBalance" x:Name="BalanceButton" AutomationProperties.AutomationId="BalanceButton"
                    MinWidth="0"
                    MinHeight="36"
                    Padding="12,0"
                    CornerRadius="8"
                    FontSize="{StaticResource ProductCaptionFontSize}"
                    Foreground="{ThemeResource TextTertiaryBrush}"
                    Style="{StaticResource TextActionButtonStyle}"
                    Visibility="Collapsed"
                    Click="Balance_Click"
                    AutomationProperties.Name="View balance and top up for this agent" />-->

            <Button x:Uid="AgentDetailShare" Content="Share"
                    MinWidth="0"
                    MinHeight="32"
                    Padding="10,0"
                    CornerRadius="8"
                    FontSize="{StaticResource ProductCaptionFontSize}"
                    Foreground="{ThemeResource TextTertiaryBrush}"
                    Style="{StaticResource TextActionButtonStyle}"
                    Click="Share_Click"
                    Visibility="{x:Bind Vm.CanShareAgent, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="Share this relay agent">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- QrCode ships only in Size20+ font files (not Size16); Size16
                                    reserved an empty slot and looked like a missing icon. -->
                            <ic:FluentIcon Icon="QrCode"
                                            IconVariant="Regular"
                                            IconSize="Size20"
                                            Foreground="{ThemeResource TextTertiaryBrush}"
                                            VerticalAlignment="Center" />
                            <TextBlock Text="{Binding}"
                                        Foreground="{ThemeResource TextTertiaryBrush}"
                                        VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
        </StackPanel>

        <StackPanel Spacing="8"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind Vm.HasAgent, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <TextBlock x:Uid="AgentEmptyTitle"
                       Text="No agent selected"
                       Style="{StaticResource ProductSubtitleTextStyle}"
                       TextAlignment="Center" />
            <TextBlock x:Uid="AgentEmptyDescription"
                       Text="Select an agent from the sidebar or add a new one to get started."
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="WrapWholeWords" />
        </StackPanel>
    </Grid>
</Page>
