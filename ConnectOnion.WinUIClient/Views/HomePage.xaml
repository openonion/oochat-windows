<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ConnectOnion.WinUIClient.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:views="using:ConnectOnion.WinUIClient.Views"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- A grouped-list row rather than a floating card. The single parent surface establishes
             the boundary; each row contributes only native hover, pressed and focus feedback. -->
        <Style x:Key="HomeAgentRowButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid"
                              Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Padding="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="ContentPresenter.Opacity" Value="0.82" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Opacity" Value="0.48" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeMetadataLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource ProductMicroFontSize}" />
            <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot"
          Background="{ThemeResource AppBackgroundBrush}"
          SizeChanged="PageRoot_SizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="ContentRoot.Margin" Value="{StaticResource PageMarginNarrow}" />
                        <Setter Target="AgentHeader.MinHeight" Value="0" />
                        <Setter Target="AddAgentHeaderButton.(Grid.Row)" Value="1" />
                        <Setter Target="AddAgentHeaderButton.(Grid.Column)" Value="0" />
                        <Setter Target="AddAgentHeaderButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="AddAgentHeaderButton.Margin" Value="0,16,0,0" />
                        <Setter Target="AutomaticStatusText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Adaptive">
                    <VisualState.Setters>
                        <Setter Target="ContentRoot.Margin" Value="{StaticResource PageMarginDefault}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.Setters>
                        <Setter Target="ContentRoot.Width" Value="{StaticResource AgentLibraryWidth}" />
                        <Setter Target="ContentRoot.HorizontalAlignment" Value="Center" />
                        <Setter Target="ContentRoot.Margin" Value="{StaticResource PageMarginWide}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- One vertical owner keeps the page predictable at narrow sizes and lets the repeater
             virtualize against the same viewport. -->
        <ScrollViewer HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ContentRoot"
                  Margin="{StaticResource PageMarginDefault}"
                  HorizontalAlignment="Stretch">
                <Grid.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </Grid.ChildrenTransitions>

                <StackPanel>
                    <!-- The home page is an Agent launcher, so the title is compact and top-aligned.
                         The list begins immediately below instead of floating under a hero logo. -->
                    <Grid x:Name="AgentHeader"
                          MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel VerticalAlignment="Center"
                                    Spacing="{StaticResource Spacing4}">
                    <TextBlock x:Uid="HomeAgentsTitle" Text="Agent library"
                                       FontSize="{StaticResource ProductHeroFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock x:Uid="HomeAgentsDescription" Text="Manage agents here. Use the sidebar to move between conversations."
                                       FontSize="{StaticResource ProductBodyFontSize}"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button x:Uid="HomeAddAgentButton" x:Name="AddAgentHeaderButton"
                                Grid.Column="1"
                                MinHeight="40"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource DefaultButtonStyle}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                AutomationProperties.AutomationId="HomeAddAgentButton"
                                AutomationProperties.Name="Add another agent"
                                Click="AddAnotherAgent_Click">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="{StaticResource Spacing8}">
                                <ic:FluentIcon Icon="Add"
                                               IconVariant="Regular"
                                               IconSize="Size16"
                                               VerticalAlignment="Center" />
                    <TextBlock x:Uid="HomeAddAgent" Text="Add Agent"
                                           FontSize="{StaticResource ProductBodyFontSize}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <InfoBar x:Uid="HomeOpenError" x:Name="PageErrorBar"
                             Margin="0,16,0,0"
                             IsOpen="False"
                             Severity="Error"
                             Title="Couldn’t open the agent"
                             AutomationProperties.LiveSetting="Assertive" />

                    <Grid Margin="0,24,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="HomeAvailableAgents" Text="Available agents"
                                   FontSize="{StaticResource ProductBodyFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock x:Uid="HomeStatusAuto"
                                   x:Name="AutomaticStatusText"
                                   Grid.Column="1"
                                   Text="Status updates automatically"
                                   FontSize="{StaticResource ProductCaptionFontSize}"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- One restrained grouped surface; Agent rows are not independent cards. -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="3"
                            Visibility="{x:Bind HasAgents, Mode=OneTime, Converter={StaticResource BoolToVis}}">
                        <ItemsRepeater x:Name="AgentList"
                                       ItemsSource="{x:Bind Agents, Mode=OneWay}"
                                       ElementPrepared="AgentList_ElementPrepared"
                                       HorizontalAlignment="Stretch">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="views:HomeAgentItem">
                                    <Button Style="{StaticResource HomeAgentRowButtonStyle}"
                                            Margin="1"
                                            Tag="{x:Bind Id}"
                                            IsEnabled="{x:Bind IsInteractionEnabled, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind AutomationName}"
                                            AutomationProperties.HelpText="{x:Bind FullAddress}"
                                            Click="AgentCard_Click">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <!-- Auto, with the fixed measure carried by the
                                                     content instead (see LastUsedPanel and the
                                                     status slot below). Every row is its own Grid
                                                     and WinUI has no SharedSizeGroup, so an Auto
                                                     column sized by its own text makes each row
                                                     land in a different place — "11 min ago" and
                                                     "Not used yet" produced visibly different
                                                     columns. Giving the *content* a fixed width
                                                     keeps the rows aligned while still letting a
                                                     collapsed panel measure zero and close the
                                                     column at narrow widths. Binding the
                                                     ColumnDefinition itself is not an option:
                                                     ColumnDefinition is not in the visual tree and
                                                     does not inherit DataContext. -->
                                                <ColumnDefinition x:Name="LastUsedColumn" Width="Auto" />
                                                <ColumnDefinition x:Name="StatusColumn" Width="Auto" />
                                                <ColumnDefinition Width="16" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Row density comes from HomeAgentItem, set by
                                                 HomePage.ApplyRowDensity from the page's own
                                                 measured width. This was an AdaptiveTrigger group,
                                                 but AdaptiveTrigger measures the *window*, and the
                                                 sidebar takes up to 288px of it — so a 920px
                                                 window put the detailed columns into a ~630px row.
                                                 A VisualStateManager inside a DataTemplate cannot
                                                 see its own viewport, so the page decides. -->

                                            <Border Grid.ColumnSpan="5"
                                                    Margin="-12,-8"
                                                    CornerRadius="7"
                                                    Background="{ThemeResource SidebarItemSelectedBrush}"
                                                    IsHitTestVisible="False"
                                                    Visibility="{x:Bind ShowSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                            <Border Grid.ColumnSpan="5"
                                                    Width="3"
                                                    Height="30"
                                                    Margin="-12,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="1.5"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    IsHitTestVisible="False"
                                                    Visibility="{x:Bind ShowSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                                            <controls:AgentAvatar Size="42"
                                                                  CornerRadius="21"
                                                                  FontSize="{StaticResource ProductCaptionFontSize}"
                                                                  Initial="{x:Bind Initial}"
                                                                  ImagePath="{x:Bind IconPath}"
                                                                  IsHitTestVisible="False"
                                                                  VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1"
                                                        Spacing="{StaticResource Spacing4}"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DisplayName}"
                                                           FontSize="{StaticResource ProductSubtitleFontSize}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ConnectionSummary}"
                                                           FontSize="{StaticResource ProductCaptionFontSize}"
                                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="EndpointText"
                                                           Text="{x:Bind ShortAddress}"
                                                           FontSize="{StaticResource ProductCaptionFontSize}"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind FullAddress}"
                                                           Visibility="{x:Bind ShowEndpoint, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <!-- Fixed width so every row's "Last used" column lands
                                                 in the same place regardless of whether its value
                                                 reads "11 min ago" or "Not used yet". Collapsed
                                                 still measures zero, which is what closes the
                                                 column on a narrow page. -->
                                            <StackPanel x:Name="LastUsedPanel"
                                                        Grid.Column="2"
                                                        Width="116"
                                                        Spacing="{StaticResource Spacing4}"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind ShowLastUsed, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <TextBlock x:Uid="HomeLastUsed" Text="Last used"
                                                           Style="{StaticResource HomeMetadataLabelStyle}" />
                                                <TextBlock Text="{x:Bind LastUsedLabel}"
                                                           FontSize="{StaticResource ProductCaptionFontSize}"
                                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Grid Grid.Column="3"
                                                  VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="{StaticResource Spacing8}"
                                                            HorizontalAlignment="Right"
                                                            AutomationProperties.Name="{x:Bind StatusAutomationName}"
                                                            Visibility="{x:Bind IsOpening, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                    <!-- One fixed-width slot for whichever indicator
                                                         is showing: the checking ring is 12px and
                                                         the dots are 8px, so without this the
                                                         column changed width the moment a presence
                                                         probe started and every row left of it
                                                         shifted. -->
                                                    <Grid Width="12" VerticalAlignment="Center">
                                                        <ProgressRing Width="12"
                                                                      Height="12"
                                                                      IsActive="{x:Bind IsChecking, Mode=OneWay}"
                                                                      AutomationProperties.Name="{x:Bind StatusAutomationName}"
                                                                      Visibility="{x:Bind IsChecking, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                        <Ellipse Width="8"
                                                                 Height="8"
                                                                 Fill="{x:Bind Presence, Mode=OneWay, Converter={StaticResource PresenceToBrush}}"
                                                                 AutomationProperties.Name="{x:Bind StatusAutomationName}"
                                                                 Visibility="{x:Bind IsStandardStatus, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                        <Ellipse Width="8"
                                                                 Height="8"
                                                                 Fill="{ThemeResource WarningBrush}"
                                                                 AutomationProperties.Name="{x:Bind StatusAutomationName}"
                                                                 Visibility="{x:Bind IsUnavailable, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                    <!-- Fixed too: "Online", "Checking" and
                                                         "Unavailable" are different widths, and an
                                                         Auto column sized by them would put each
                                                         row's status in a different place. -->
                                                    <TextBlock x:Name="StatusLabelText"
                                                               Width="76"
                                                               Text="{x:Bind StatusLabel, Mode=OneWay}"
                                                               FontSize="{StaticResource ProductCaptionFontSize}"
                                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               VerticalAlignment="Center"
                                                               Visibility="{x:Bind ShowStatusLabel, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <!-- Shares the cell with the status panel above and
                                                     is deliberately measured the same (12px
                                                     indicator slot, 76px label): this swaps in the
                                                     moment a row is clicked, and a different width
                                                     would make the whole row twitch on click. -->
                                                <StackPanel x:Uid="HomeOpeningAgent" Orientation="Horizontal"
                                                            Spacing="{StaticResource Spacing8}"
                                                            HorizontalAlignment="Right"
                                                            AutomationProperties.Name="Opening agent"
                                                            Visibility="{x:Bind IsOpening, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                    <ProgressRing Width="12"
                                                                  Height="12"
                                                                  VerticalAlignment="Center"
                                                                  IsActive="{x:Bind IsOpening, Mode=OneWay}" />
                                                    <TextBlock x:Uid="HomeOpening"
                                                               x:Name="OpeningLabelText"
                                                               Width="76"
                                                               Text="Opening"
                                                               FontSize="{StaticResource ProductCaptionFontSize}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               VerticalAlignment="Center"
                                                               Visibility="{x:Bind ShowStatusLabel, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Grid>

                                            <ic:FluentIcon Grid.Column="4"
                                                           Icon="ChevronRight"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{x:Bind IsOpening, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                                            <Rectangle Grid.Column="1"
                                                       Grid.ColumnSpan="4"
                                                       Height="1"
                                                       Margin="0,0,-12,-12"
                                                       VerticalAlignment="Bottom"
                                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                       Opacity="0.55"
                                                       IsHitTestVisible="False" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>

                    <Border MinHeight="150"
                            Padding="24"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{x:Bind HasAgents, Mode=OneTime, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <!-- First-run dead end, fixed. This state used to say only "Add an agent to
                             start a conversation", which is unactionable advice for the one user
                             who sees it: a fresh install has no agent, and the Add Agent form asks
                             for a 0x address or URL that a new user has no way to have. It now
                             says what an agent address is, offers the action inline, and links to
                             the docs that explain how to get one. -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="420"
                                    Spacing="{StaticResource Spacing12}">
                            <ic:FluentIcon Icon="Bot"
                                           IconVariant="Regular"
                                           IconSize="Size24"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            <TextBlock x:Uid="HomeNoAgents" Text="No agents yet"
                                       FontSize="{StaticResource ProductSubtitleFontSize}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Uid="HomeNoAgentsHint"
                                       Text="An agent is a ConnectOnion-compatible assistant you connect to. You need its 0x address or its HTTP URL — whoever runs the agent can give you one from its Share screen."
                                       FontSize="{StaticResource ProductCaptionFontSize}"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="{StaticResource Spacing8}"
                                        Margin="0,4,0,0">
                                <Button x:Uid="HomeEmptyAddAgent"
                                        Content="Add your first agent"
                                        Style="{StaticResource AccentButtonStyle}"
                                        AutomationProperties.AutomationId="EmptyStateAddAgentButton"
                                        Click="AddAnotherAgent_Click" />
                                <HyperlinkButton x:Uid="HomeEmptyDocs"
                                                 Content="How do I get one?"
                                                 AutomationProperties.AutomationId="EmptyStateDocsLink"
                                                 Click="EmptyStateDocs_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
