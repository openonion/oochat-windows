<Page
    x:Class="ConnectOnion.WinUIClient.Views.WorkRoomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:models="using:ConnectOnion.WinUIClient.Models"
    SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <!-- template for the provider message --> 
        <DataTemplate x:Key="RoomMessageTemplate" x:DataType="models:ProviderWorkRoomMessage">
            <Grid Margin="0,5">
                <StackPanel MaxWidth="{StaticResource ChatColumnWidth}"
                            HorizontalAlignment="Stretch"
                            Spacing="8"
                            Visibility="{x:Bind IsAssistant, Converter={StaticResource BoolToVis}}">
                    <controls:MarkdownTextBlock Markdown="{x:Bind Text}"
                                                FontSize="{StaticResource ProductBodyFontSize}"
                                                MaxWidth="{StaticResource ChatReadingWidth}"
                                                HorizontalAlignment="Left"
                                                Foreground="{ThemeResource TextPrimaryBrush}"
                                                AutomationProperties.Name="{x:Bind Text}" />
                    <Button Padding="2"
                            MinWidth="40"
                            MinHeight="40"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            IsTabStop="True"
                            Click="CopyProviderResponse_Click"
                            AutomationProperties.Name="Copy response"
                            ToolTipService.ToolTip="Copy response">
                        <ic:FluentIcon Icon="Copy" IconVariant="Regular" IconSize="Size16"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Button>
                </StackPanel>
                <Border Padding="14,10"
                        MaxWidth="760"
                        HorizontalAlignment="Right"
                        CornerRadius="12"
                        Background="{ThemeResource UserMessageBackgroundBrush}"
                        Visibility="{x:Bind IsUser, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="You"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Text="{x:Bind Text}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind DeliveryLabel}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   Visibility="{x:Bind DeliveryLabel, Converter={StaticResource StringToVis}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- template for the workspace files reported by the provider -->
        <DataTemplate x:Key="RoomFileTemplate" x:DataType="models:ProviderWorkRoomFile">
            <Grid Margin="0,3" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ic:FluentIcon Icon="Document" IconVariant="Regular" IconSize="Size16"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Path}"
                           FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Grid.Column="2" Text="{x:Bind Status}"
                           FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}" />
            </Grid>
        </DataTemplate>

        <!-- template for approval requests sent by the host -->
        <DataTemplate x:Key="RoomApprovalTemplate" x:DataType="models:ProviderWorkRoomApproval">
            <Border Margin="0,5" Padding="14" CornerRadius="10"
                    Background="{ThemeResource UserMessageBackgroundBrush}"
                    BorderBrush="{ThemeResource BorderDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Approval required" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Risk}" FontSize="11"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Grid>
                    <TextBlock Text="{x:Bind Summary}" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Scope}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Visibility="{x:Bind Scope, Converter={StaticResource StringToVis}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind IsPending, Converter={StaticResource BoolToVis}}">
                        <Button Content="Approve" Tag="{x:Bind}" Click="ApprovalApprove_Click"
                                Visibility="{x:Bind AllowsApprove, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Reject" Tag="{x:Bind}" Click="ApprovalReject_Click"
                                Visibility="{x:Bind AllowsReject, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!-- workroom overall layout shell -->
    <Grid Background="{ThemeResource ChatBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header row with navigation, provider status, and permission selector -->
        <Border Grid.Row="0" Padding="20,0" Background="{ThemeResource ChatBackgroundBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="←  Back" Padding="10,6" Click="Back_Click"
                        AutomationProperties.Name="Back to conversation" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Vm.Room.Title, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Vm.ProviderHeader, Mode=OneWay}" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- provider permission dropdown, greyed out if host doesn't support permission changes -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Permissions" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <ComboBox Width="160"
                              ItemsSource="{x:Bind Vm.PermissionOptions, Mode=OneWay}"
                              SelectedValuePath="Id"
                              SelectedValue="{x:Bind Vm.SelectedPermissionId, Mode=OneWay}"
                              SelectionChanged="PermissionSelector_SelectionChanged"
                              IsEnabled="{x:Bind Vm.CanChangePermission, Mode=OneWay}"
                              Visibility="{x:Bind Vm.HasPermission, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                              AutomationProperties.Name="Workroom permission profile">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ProviderWorkRoomPermissionOption">
                                <TextBlock Text="{x:Bind Label}" FontSize="13" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- scrollable content (approvals, conversation, changed files) -->
        <ScrollViewer x:Name="RoomScrollViewer" Grid.Row="1"
                      SizeChanged="RoomScrollViewer_SizeChanged"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      BringIntoViewOnFocusChange="False">
            <StackPanel x:Name="RoomContentStack" Width="1000"
                        Margin="0,24,0,32" HorizontalAlignment="Center" Spacing="20">

                <!-- approval panel -->
                <StackPanel Spacing="8" Visibility="{x:Bind Vm.HasApprovals, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Approvals" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Sending approval response to host" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               Visibility="{x:Bind Vm.IsResolvingApproval, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{x:Bind Vm.Room.Approvals, Mode=OneWay}"
                                  ItemTemplate="{StaticResource RoomApprovalTemplate}" />
                </StackPanel>

                <!-- conversation panel with user and provider message in that order -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Conversation" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="The host has not provided any provider messages for this room."
                               FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}"
                               Visibility="{x:Bind Vm.HasMessages, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{x:Bind Vm.Room.Messages, Mode=OneWay}"
                                  ItemTemplate="{StaticResource RoomMessageTemplate}" />
                </StackPanel>

                <!-- activity panel that lists the files reported by the provider -->
                <StackPanel Spacing="8" Visibility="{x:Bind Vm.HasFiles, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Activity" FontSize="14" FontWeight="SemiBold" />
                    <Border Padding="12" CornerRadius="10" Background="{ThemeResource SurfaceSecondaryBrush}"
                            BorderBrush="{ThemeResource BorderDefaultBrush}" BorderThickness="1">
                        <ItemsControl ItemsSource="{x:Bind Vm.Room.Files, Mode=OneWay}"
                                      ItemTemplate="{StaticResource RoomFileTemplate}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- fixed panel for room text input, stop, send, and request status -->
        <Border Grid.Row="2" Padding="0,12,0,10" Background="{ThemeResource ChatBackgroundBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <StackPanel x:Name="ComposerColumn"
                        HorizontalAlignment="Center" Spacing="6">
                <Border
                        CornerRadius="12"
                        Background="{ThemeResource ComposerBackgroundBrush}"
                        BorderBrush="{ThemeResource ComposerBorderBrush}"
                        BorderThickness="1">
                    <Grid MinHeight="76" Padding="12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="ComposerBox"
                                 Grid.Row="0"
                                 Text="{x:Bind Vm.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Send a message to the Workroom provider"
                                 PlaceholderForeground="{ThemeResource ComposerPlaceholderBrush}"
                                 Foreground="{ThemeResource ComposerTextBrush}"
                                 FontSize="{StaticResource ProductSubtitleFontSize}"
                                 VerticalContentAlignment="Top"
                                 MinHeight="32"
                                 MaxHeight="144"
                                 Padding="0,3"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 IsEnabled="{x:Bind Vm.CanContinue, Mode=OneWay}"
                                 PreviewKeyDown="ComposerBox_PreviewKeyDown"
                                 AutomationProperties.Name="Message for coding agent">
                            <TextBox.Resources>
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                            </TextBox.Resources>
                        </TextBox>
                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    CornerRadius="20"
                                    BorderThickness="0"
                                    Background="{ThemeResource ComposerStopButtonBackgroundBrush}"
                                    Visibility="{x:Bind Vm.CanStop, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Click="Stop_Click"
                                    AutomationProperties.Name="Stop coding agent">
                                <Rectangle Width="9" Height="9" RadiusX="1" RadiusY="1"
                                           Fill="{ThemeResource ComposerStopButtonForegroundBrush}" />
                            </Button>
                            <Button Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    CornerRadius="20"
                                    BorderThickness="0"
                                    Background="{x:Bind Vm.CanSend, Mode=OneWay, Converter={StaticResource BoolToResourceBrush}, ConverterParameter=ComposerPrimaryButtonBackgroundBrush|ComposerDisabledButtonBackgroundBrush}"
                                    IsEnabled="{x:Bind Vm.CanSend, Mode=OneWay}"
                                    Visibility="{x:Bind Vm.CanStop, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                    Click="Send_Click"
                                    AutomationProperties.Name="Send to coding agent">
                                <ic:FluentIcon Icon="ArrowUp" IconVariant="Regular" IconSize="Size20"
                                               Foreground="{x:Bind Vm.CanSend, Mode=OneWay, Converter={StaticResource BoolToResourceBrush}, ConverterParameter=ComposerPrimaryButtonForegroundBrush|ComposerDisabledButtonForegroundBrush}" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
                <TextBlock Text="{x:Bind Vm.ComposerUnavailableText, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           Visibility="{x:Bind Vm.CanContinue, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                <TextBlock Text="{x:Bind Vm.ErrorMessage, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind Vm.ErrorMessage, Converter={StaticResource StringToVis}}" />
                <TextBlock Text="{x:Bind Vm.PermissionStatus, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           Visibility="{x:Bind Vm.PermissionStatus, Converter={StaticResource StringToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
