<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ConnectOnion.WinUIClient.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="0"
    HorizontalAlignment="Stretch">

    <ScrollViewer x:Name="ContentScrollViewer"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ContentStack" MinWidth="0" Margin="{StaticResource SettingsContentMargin}"
                    HorizontalAlignment="Stretch" Spacing="{StaticResource Spacing20}">
            <TextBlock x:Uid="SettingsDescription" Text="Desktop preferences for this app."
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />

            <InfoBar x:Name="SettingsErrorBar"
                     x:Uid="SettingsSaveError"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Error"
                     Title="Setting not saved"
                     Message="ConnectOnion couldn't save this change. Try again."
                     AutomationProperties.LiveSetting="Assertive" />

            <TextBlock x:Name="SearchEmptyState"
                       x:Uid="SettingsSearchEmpty"
                       Text="No settings match your search."
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextSecondaryBrush}" />

            <!-- Appearance is strictly how the app looks. Anything about how chat behaves or reads
                 lives in the Chat group below — both are shown for the "General" category. -->
            <StackPanel x:Name="GeneralSection" Spacing="4">
                <TextBlock x:Uid="SettingsAppearance" AutomationProperties.HeadingLevel="Level2" Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" Margin="2,0,0,4" />

                <ctk:SettingsCard x:Uid="SettingsTheme" Header="Theme"
                                  Description="Use the system theme or choose light or dark mode.">
                    <RadioButtons x:Uid="SettingsThemeChoice" x:Name="ThemeChoice" MaxColumns="3"
                                  AutomationProperties.Name="Theme"
                                  SelectionChanged="ThemeChoice_SelectionChanged">
                        <x:String>System</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </RadioButtons>
                </ctk:SettingsCard>

                <ctk:SettingsCard x:Uid="SettingsInterfaceTextSize" Header="Interface text size"
                                  Description="Adjust text across navigation, settings, buttons, cards, and dialogs.">
                    <RadioButtons x:Uid="SettingsInterfaceTextSizeChoice"
                                  x:Name="InterfaceTextSizeChoice"
                                  MaxColumns="3"
                                  AutomationProperties.AutomationId="InterfaceTextSizeChoice"
                                  AutomationProperties.Name="Interface text size"
                                  SelectionChanged="InterfaceTextSizeChoice_SelectionChanged" />
                </ctk:SettingsCard>

                <ctk:SettingsCard x:Uid="SettingsLanguage" Header="Language"
                                  Description="Choose the language used by ConnectOnion.">
                    <ComboBox x:Uid="SettingsLanguageChoice" x:Name="LanguageChoice"
                              MinWidth="180"
                              HorizontalAlignment="Right"
                              AutomationProperties.AutomationId="LanguageChoice"
                              AutomationProperties.Name="Application language"
                              SelectionChanged="LanguageChoice_SelectionChanged">
                        <ComboBoxItem x:Uid="SettingsLanguageEnglish" Content="English" />
                        <ComboBoxItem x:Uid="SettingsLanguageChinese" Content="Simplified Chinese" />
                    </ComboBox>
                </ctk:SettingsCard>

                <!-- WinUI resolves x:Uid once, when a page is constructed, so switching language
                     cannot re-translate the live visual tree the way a theme flip re-resolves
                     ThemeResource. The restart is therefore real — but it used to be a notice with
                     nothing to act on, leaving the user to find the tray, exit and relaunch. The
                     button does it for them. -->
                <InfoBar x:Name="LanguageRestartInfo"
                         x:Uid="SettingsLanguageRestart"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational"
                         Title="Restart required"
                         Message="Restart ConnectOnion to apply the selected language.">
                    <InfoBar.ActionButton>
                        <Button x:Uid="SettingsLanguageRestartNow"
                                Content="Restart now"
                                AutomationProperties.AutomationId="LanguageRestartNowButton"
                                Click="LanguageRestartNow_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <!-- The close-button choice used to be settable exactly once, from the prompt shown
                 the first time the window was closed ("We'll remember your choice"). It was
                 remembered — with no way to change it afterwards, so a user who picked Exit had
                 turned the title-bar X into an unconfirmed quit, permanently. -->
            <StackPanel x:Name="WindowSection" Spacing="4">
                <TextBlock x:Uid="SettingsWindow" AutomationProperties.HeadingLevel="Level2" Text="Window" Style="{StaticResource SubtitleTextBlockStyle}" Margin="2,0,0,4" />

                <ctk:SettingsCard x:Uid="SettingsCloseBehavior" Header="When you close the window"
                                  Description="Closing can keep agent turns running in the tray, or exit the app.">
                    <ComboBox x:Uid="SettingsCloseBehaviorChoice" x:Name="CloseBehaviorChoice"
                              MinWidth="180"
                              HorizontalAlignment="Right"
                              AutomationProperties.AutomationId="CloseBehaviorChoice"
                              AutomationProperties.Name="Window close behavior"
                              SelectionChanged="CloseBehaviorChoice_SelectionChanged">
                        <ComboBoxItem x:Uid="SettingsCloseBehaviorAsk" Content="Ask every time" />
                        <ComboBoxItem x:Uid="SettingsCloseBehaviorTray" Content="Keep running in the tray" />
                        <ComboBoxItem x:Uid="SettingsCloseBehaviorExit" Content="Exit ConnectOnion" />
                    </ComboBox>
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel x:Name="ChatSection" Spacing="4">
                <TextBlock x:Uid="SettingsChat" AutomationProperties.HeadingLevel="Level2" Text="Chat" Style="{StaticResource SubtitleTextBlockStyle}" Margin="2,0,0,4" />

                <ctk:SettingsCard x:Uid="SettingsMessageSize" Header="Message text size"
                                  Description="Adjust how large chat messages appear.">
                    <RadioButtons x:Uid="SettingsFontChoice" x:Name="FontChoice" MaxColumns="3"
                                  AutomationProperties.Name="Message text size"
                                  SelectionChanged="FontChoice_SelectionChanged">
                        <x:String>Small</x:String>
                        <x:String>Medium</x:String>
                        <x:String>Large</x:String>
                    </RadioButtons>
                </ctk:SettingsCard>

                <ctk:SettingsCard x:Uid="SettingsEnterToSend" Header="Enter to send"
                                  Description="When enabled, Enter sends and Shift+Enter inserts a new line.">
                    <ToggleSwitch x:Name="EnterToSendSwitch" AutomationProperties.AutomationId="EnterToSendSwitch"
                                  x:Uid="SettingsEnterToSendSwitch"
                                  OnContent="On"
                                  OffContent="Off"
                                  AutomationProperties.Name="Enter to send"
                                  Toggled="EnterToSendSwitch_Toggled" />
                </ctk:SettingsCard>
            </StackPanel>

            <StackPanel x:Name="NotificationsSection" Spacing="4" Visibility="Collapsed">
                <TextBlock x:Uid="SettingsNotifications" AutomationProperties.HeadingLevel="Level2" Text="Notifications" Style="{StaticResource SubtitleTextBlockStyle}" Margin="2,0,0,4" />

                <InfoBar x:Uid="SettingsSystemNotificationsUnavailable"
                         x:Name="SystemNotificationsUnavailableInfoBar"
                         IsOpen="False"
                         IsClosable="False"
                         Severity="Informational"
                         Title="Windows notifications unavailable"
                         Message="In-app alerts remain available while this window is open. Background Windows notifications require the Windows App Runtime notification service on this PC."
                         AutomationProperties.AutomationId="SystemNotificationsUnavailableInfoBar" />

                <ctk:SettingsCard x:Uid="SettingsNotificationsEnable" Header="Enable notifications"
                                  Description="Master switch for all in-app and Windows notifications.">
                    <ToggleSwitch x:Uid="SettingsNotificationsSwitch" x:Name="EnableNotificationsSwitch" AutomationProperties.AutomationId="EnableNotificationsSwitch"
                                  AutomationProperties.Name="Enable notifications"
                                  Toggled="EnableNotificationsSwitch_Toggled" />
                </ctk:SettingsCard>

                <ContentControl x:Name="NotificationDetailPanel"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="4">
                        <ctk:SettingsCard x:Uid="SettingsAgentReplies" Header="Agent replies"
                                          Description="Notify when an agent finishes replying in a conversation you're not viewing.">
                            <ToggleSwitch x:Uid="SettingsNotifyReplies" x:Name="NotifyAgentRepliesSwitch" AutomationProperties.AutomationId="NotifyAgentRepliesSwitch"
                                          AutomationProperties.Name="Notify for agent replies"
                                          Toggled="NotificationDetail_Toggled" />
                        </ctk:SettingsCard>

                        <ctk:SettingsCard x:Uid="SettingsTaskCompletion" Header="Task completion"
                                          Description="Notify when a longer, multi-step task finishes.">
                            <ToggleSwitch x:Uid="SettingsNotifyTasks" x:Name="NotifyTaskCompletionSwitch" AutomationProperties.AutomationId="NotifyTaskCompletionSwitch"
                                          AutomationProperties.Name="Notify for task completion"
                                          Toggled="NotificationDetail_Toggled" />
                        </ctk:SettingsCard>

                        <ctk:SettingsCard x:Uid="SettingsApprovalRequests" Header="Approval requests"
                                          Description="Notify when an agent needs your approval to continue.">
                            <ToggleSwitch x:Uid="SettingsNotifyApprovals" x:Name="NotifyApprovalRequestsSwitch" AutomationProperties.AutomationId="NotifyApprovalRequestsSwitch"
                                          AutomationProperties.Name="Notify for approval requests"
                                          Toggled="NotificationDetail_Toggled" />
                        </ctk:SettingsCard>

                        <ctk:SettingsCard x:Uid="SettingsConnectionProblems" Header="Connection problems"
                                          Description="Notify when an agent stays disconnected for a while.">
                            <ToggleSwitch x:Uid="SettingsNotifyConnection" x:Name="NotifyConnectionProblemsSwitch" AutomationProperties.AutomationId="NotifyConnectionProblemsSwitch"
                                          AutomationProperties.Name="Notify for connection problems"
                                          Toggled="NotificationDetail_Toggled" />
                        </ctk:SettingsCard>

                        <ctk:SettingsCard x:Uid="SettingsPlaySound" Header="Play sound"
                                          Description="Play a sound with Windows notifications.">
                            <ToggleSwitch x:Uid="SettingsNotifySound" x:Name="PlayNotificationSoundSwitch" AutomationProperties.AutomationId="PlayNotificationSoundSwitch"
                                          AutomationProperties.Name="Play notification sound"
                                          Toggled="NotificationDetail_Toggled" />
                        </ctk:SettingsCard>

                        <ctk:SettingsCard x:Uid="SettingsMessagePreview" Header="Show message preview"
                                          Description="Include a snippet of the reply. When off, notifications only say you have a new response.">
                            <ToggleSwitch x:Uid="SettingsNotifyPreview" x:Name="ShowMessagePreviewSwitch" AutomationProperties.AutomationId="ShowMessagePreviewSwitch"
                                          AutomationProperties.Name="Show message preview"
                                          Toggled="NotificationDetail_Toggled" />
                        </ctk:SettingsCard>
                    </StackPanel>
                </ContentControl>
            </StackPanel>

            <StackPanel x:Name="AudioSection" Spacing="4" Visibility="Collapsed">
                <TextBlock x:Uid="SettingsAudio" AutomationProperties.HeadingLevel="Level2" Text="Audio" Style="{StaticResource SubtitleTextBlockStyle}" Margin="2,0,0,4" />

                <ctk:SettingsCard x:Uid="SettingsMicrophone" Header="Microphone"
                                  Description="Choose the microphone for voice input. Recordings are sent to OpenOnion for cloud transcription after consent.">
                    <ComboBox x:Uid="SettingsMicChoice" x:Name="MicChoice" AutomationProperties.AutomationId="MicChoice"
                              MinWidth="0" MaxWidth="260"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Microphone"
                              DisplayMemberPath="Name"
                              SelectionChanged="MicChoice_SelectionChanged" />
                </ctk:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
