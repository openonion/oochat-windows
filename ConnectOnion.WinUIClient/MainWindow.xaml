<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ConnectOnion.WinUIClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ConnectOnion">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" AutomationProperties.AutomationId="MainWindow"
          Background="{ThemeResource AppBackgroundBrush}" SizeChanged="RootGrid_SizeChanged">
        <Grid.Resources>
            <Style x:Key="ShellMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="{StaticResource ProductBodyFontSize}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="TitleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallIconButtonStyle}">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
            </Style>

            <Style x:Key="ZoomHudButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallIconButtonStyle}">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>

            <Style x:Key="FindHudButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallIconButtonStyle}">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <!-- Height is re-set from UpdateTitleBarScale when the OS text-size setting is above
                 100%; 32 is the standard caption and the value it returns to. -->
            <RowDefinition x:Name="TitleBarRow" Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="ConnectOnion"
            IconSource="ms-appx:///Assets/app-icon.ico"
            LeftClickCommand="{x:Bind OpenWindowCommand}"
            NoLeftClickDelay="True"
            ContextMenuMode="PopupMenu">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout x:Name="TrayContextMenu"
                            AreOpenCloseAnimationsEnabled="False"
                            Opening="TrayContextMenu_Opening">
                    <MenuFlyoutItem
                        x:Uid="HistoryRecentChats"
                        x:Name="RecentChatsHeader" AutomationProperties.AutomationId="RecentChatsHeader"
                        Text="Recent chats"
                        IsEnabled="False" />
                    <MenuFlyoutSeparator x:Name="RecentChatsEndSeparator" />
                    <MenuFlyoutItem
                        x:Uid="HistoryExit"
                        Text="Exit"
                        Command="{x:Bind ExitFromTrayCommand}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <Grid Grid.Row="0"
              x:Name="TitleBarArea"
              Background="{ThemeResource SidebarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <!-- Widened by UpdateTitleBarScale to match the render transform, which does not
                     resize the layout slot on its own. -->
                <ColumnDefinition x:Name="TitleBarContentColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
                <!-- 144 is only the pre-measurement fallback (three buttons at 100%). The real
                     width comes from AppWindowTitleBar's inset — see UpdateCaptionButtonsColumn. -->
                <ColumnDefinition x:Name="CaptionButtonsColumn" Width="144" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TitleBarContent" Grid.Column="0" Orientation="Horizontal" Spacing="2" Padding="10,0,0,0">
                <Button x:Uid="MainToggleSidebar" x:Name="SidebarToggleButton" AutomationProperties.AutomationId="SidebarToggleButton"
                        Style="{StaticResource TitleIconButtonStyle}"
                        Click="SidebarToggle_Click"
                        AutomationProperties.Name="Toggle sidebar"
                        ToolTipService.ToolTip="Toggle sidebar">
                    <ic:FluentIcon Icon="PanelLeft"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                </Button>
                <Button x:Uid="MainNavigateBack" x:Name="BackButton" AutomationProperties.AutomationId="BackButton"
                        Style="{StaticResource TitleIconButtonStyle}"
                        Click="Back_Click"
                        AutomationProperties.Name="Back"
                        ToolTipService.ToolTip="Back">
                    <!-- Disabled Back/Forward show no background (transparent, flush with the
                         title bar) — the arrow icon's own color is what signals disabled; see
                         UpdateNavigationButtons. -->
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    </Button.Resources>
                    <ic:FluentIcon x:Name="BackIcon"
                                   Icon="ArrowLeft"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                </Button>
                <Button x:Uid="MainNavigateForward" x:Name="ForwardButton" AutomationProperties.AutomationId="ForwardButton"
                        Style="{StaticResource TitleIconButtonStyle}"
                        Click="Forward_Click"
                        AutomationProperties.Name="Forward"
                        ToolTipService.ToolTip="Forward">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    </Button.Resources>
                    <ic:FluentIcon x:Name="ForwardIcon"
                                   Icon="ArrowRight"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                </Button>
            <MenuBar x:Name="TitleBarMenu"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalAlignment="Center">
            <MenuBarItem x:Uid="MenuFile" Title="File"
                         AutomationProperties.AutomationId="FileMenuButton">
                        <MenuFlyoutItem x:Uid="MenuNewChat" x:Name="NewChatMenuItem" AutomationProperties.AutomationId="NewChatMenuItem" Text="New Chat"
                                        KeyboardAcceleratorTextOverride="Ctrl+N"
                                        Click="NewChat_Click" />
                        <MenuFlyoutItem x:Uid="MenuOpenFolder" x:Name="OpenFolderMenuItem" AutomationProperties.AutomationId="OpenFolderMenuItem" Text="Open Data Folder"
                                        KeyboardAcceleratorTextOverride="Ctrl+O"
                                        Click="OpenFolder_Click" />
                        <MenuFlyoutItem x:Uid="MenuClose" x:Name="CloseWindowMenuItem" AutomationProperties.AutomationId="CloseWindowMenuItem" Text="Hide to Tray"
                                        KeyboardAcceleratorTextOverride="Ctrl+W"
                                        Click="CloseWindow_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuSettings" x:Name="SettingsMenuItem" AutomationProperties.AutomationId="SettingsMenuItem" Text="Settings..."
                                        KeyboardAcceleratorTextOverride="Ctrl+,"
                                        Click="SettingsMenu_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuExit" x:Name="ExitMenuItem" AutomationProperties.AutomationId="ExitMenuItem" Text="Exit"
                                        KeyboardAcceleratorTextOverride="Ctrl+Q"
                                        Click="Exit_Click" />
                    </MenuBarItem>
            <MenuBarItem x:Uid="MenuEdit" x:Name="EditMenuBarItem" Title="Edit">
                        <MenuFlyoutItem x:Uid="MenuUndo" Text="Undo"
                                        KeyboardAcceleratorTextOverride="Ctrl+Z"
                                        Click="Undo_Click" />
                        <MenuFlyoutItem x:Uid="MenuRedo" Text="Redo"
                                        KeyboardAcceleratorTextOverride="Ctrl+Y"
                                        Click="Redo_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuCut" Text="Cut"
                                        KeyboardAcceleratorTextOverride="Ctrl+X"
                                        Click="Cut_Click" />
                        <MenuFlyoutItem x:Uid="MenuCopy" Text="Copy"
                                        KeyboardAcceleratorTextOverride="Ctrl+C"
                                        Click="Copy_Click" />
                        <MenuFlyoutItem x:Uid="MenuPaste" Text="Paste"
                                        KeyboardAcceleratorTextOverride="Ctrl+V"
                                        Click="Paste_Click" />
                        <MenuFlyoutItem x:Uid="MenuDelete" Text="Delete"
                                        Click="Delete_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuSelectAll" Text="Select All"
                                        KeyboardAcceleratorTextOverride="Ctrl+A"
                                        Click="SelectAll_Click" />
                    </MenuBarItem>
            <MenuBarItem x:Uid="MenuView" x:Name="ViewMenuBarItem" Title="View">
                        <MenuFlyoutItem x:Uid="MenuToggleSidebar" x:Name="ToggleSidebarMenuItem" AutomationProperties.AutomationId="ToggleSidebarMenuItem" Text="Toggle Sidebar"
                                        KeyboardAcceleratorTextOverride="Ctrl+B"
                                        Click="ToggleSidebarMenu_Click" />
                        <MenuFlyoutItem x:Uid="MenuOpenTerminal" x:Name="OpenTerminalMenuItem" AutomationProperties.AutomationId="OpenTerminalMenuItem" Text="Open Terminal in Data Folder"
                                        KeyboardAcceleratorTextOverride="Ctrl+`"
                                        Click="OpenTerminal_Click" />
                        <MenuFlyoutItem x:Uid="MenuFind" x:Name="FindMenuItem" AutomationProperties.AutomationId="FindMenuItem" Text="Find"
                                        KeyboardAcceleratorTextOverride="Ctrl+F"
                                        Click="Find_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuBack" x:Name="BackMenuItem" AutomationProperties.AutomationId="BackMenuItem" Text="Back"
                                        KeyboardAcceleratorTextOverride="Ctrl+["
                                        Click="BackMenu_Click" />
                        <MenuFlyoutItem x:Uid="MenuForward" x:Name="ForwardMenuItem" AutomationProperties.AutomationId="ForwardMenuItem" Text="Forward"
                                        KeyboardAcceleratorTextOverride="Ctrl+]"
                                        Click="ForwardMenu_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuZoomIn" x:Name="ZoomInMenuItem" AutomationProperties.AutomationId="ZoomInMenuItem" Text="Zoom In"
                                        KeyboardAcceleratorTextOverride="Ctrl+Shift+="
                                        Click="ZoomIn_Click" />
                        <MenuFlyoutItem x:Uid="MenuZoomOut" x:Name="ZoomOutMenuItem" AutomationProperties.AutomationId="ZoomOutMenuItem" Text="Zoom Out"
                                        KeyboardAcceleratorTextOverride="Ctrl+-"
                                        Click="ZoomOut_Click" />
                        <MenuFlyoutItem x:Uid="MenuActualSize" Text="Actual Size"
                                        Click="ActualSize_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuFullScreen" x:Name="FullScreenMenuItem" AutomationProperties.AutomationId="FullScreenMenuItem" Text="Toggle Full Screen"
                                        KeyboardAcceleratorTextOverride="F11"
                                        Click="ToggleFullScreen_Click" />
                    </MenuBarItem>
            <MenuBarItem x:Uid="MenuMore" x:Name="CompactMenuBarItem" Title="More"
                         Visibility="Collapsed"
                         AutomationProperties.AutomationId="CompactMenuButton">
                        <MenuFlyoutSubItem x:Uid="CompactMenuEdit" Text="Edit">
                            <MenuFlyoutItem x:Uid="CompactMenuUndo" Text="Undo" KeyboardAcceleratorTextOverride="Ctrl+Z" Click="Undo_Click" />
                            <MenuFlyoutItem x:Uid="CompactMenuRedo" Text="Redo" KeyboardAcceleratorTextOverride="Ctrl+Y" Click="Redo_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="CompactMenuCut" Text="Cut" KeyboardAcceleratorTextOverride="Ctrl+X" Click="Cut_Click" />
                            <MenuFlyoutItem x:Uid="CompactMenuCopy" Text="Copy" KeyboardAcceleratorTextOverride="Ctrl+C" Click="Copy_Click" />
                            <MenuFlyoutItem x:Uid="CompactMenuPaste" Text="Paste" KeyboardAcceleratorTextOverride="Ctrl+V" Click="Paste_Click" />
                            <MenuFlyoutItem x:Uid="CompactMenuDelete" Text="Delete" Click="Delete_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="CompactMenuSelectAll" Text="Select All" KeyboardAcceleratorTextOverride="Ctrl+A" Click="SelectAll_Click" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem x:Uid="CompactMenuView" Text="View">
                            <MenuFlyoutItem x:Uid="CompactMenuToggleSidebar" Text="Toggle Sidebar" KeyboardAcceleratorTextOverride="Ctrl+B" Click="ToggleSidebarMenu_Click" />
                            <MenuFlyoutItem x:Uid="CompactMenuOpenTerminal" Text="Open Terminal in Data Folder" KeyboardAcceleratorTextOverride="Ctrl+`" Click="OpenTerminal_Click" />
                            <MenuFlyoutItem x:Uid="CompactMenuFind" Text="Find" KeyboardAcceleratorTextOverride="Ctrl+F" Click="Find_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="CompactMenuBack" Text="Back" KeyboardAcceleratorTextOverride="Ctrl+[" Click="BackMenu_Click" />
                            <MenuFlyoutItem x:Uid="CompactMenuForward" Text="Forward" KeyboardAcceleratorTextOverride="Ctrl+]" Click="ForwardMenu_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="CompactMenuZoomIn" Text="Zoom In" KeyboardAcceleratorTextOverride="Ctrl+Shift+=" Click="ZoomIn_Click" />
                            <MenuFlyoutItem x:Uid="CompactMenuZoomOut" Text="Zoom Out" KeyboardAcceleratorTextOverride="Ctrl+-" Click="ZoomOut_Click" />
                            <MenuFlyoutItem x:Uid="CompactMenuActualSize" Text="Actual Size" Click="ActualSize_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="CompactMenuFullScreen" Text="Toggle Full Screen" KeyboardAcceleratorTextOverride="F11" Click="ToggleFullScreen_Click" />
                        </MenuFlyoutSubItem>
                    </MenuBarItem>
            <MenuBarItem x:Uid="MenuHelp" x:Name="HelpMenuBarItem" Title="Help" AutomationProperties.AutomationId="HelpMenuButton">
                        <MenuFlyoutItem x:Uid="MenuKeyboardShortcuts" x:Name="KeyboardShortcutsMenuItem" Text="Keyboard shortcuts" AutomationProperties.AutomationId="KeyboardShortcutsMenuItem"
                                        KeyboardAcceleratorTextOverride="Ctrl+Shift+/"
                                        Click="KeyboardShortcuts_Click" />
                        <MenuFlyoutItem x:Uid="MenuDocs" Text="ConnectOnion Docs" AutomationProperties.AutomationId="ConnectOnionDocsMenuItem"
                                        Click="ConnectOnionDocs_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuAbout" Text="About ConnectOnion" AutomationProperties.AutomationId="AboutMenuItem"
                                        Click="AboutConnectOnion_Click" />
                    </MenuBarItem>
                </MenuBar>
            </StackPanel>

            <Grid x:Name="TitleBarDragRegion"
                  Grid.Column="1"
                  Background="Transparent" />
        </Grid>

        <Grid x:Name="MainContentArea"
              Grid.Row="1"
              Background="{ThemeResource SidebarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ShellSidebarColumn" Width="288" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Rectangle x:Uid="SidebarDismissLayer" x:Name="SidebarDismissLayer"
                       Grid.ColumnSpan="2"
                       Canvas.ZIndex="9"
                       Fill="{ThemeResource SettingsBackdropBrush}"
                       Visibility="Collapsed"
                       Tapped="SidebarDismissLayer_Tapped"
                       AutomationProperties.Name="Close navigation drawer" />

            <controls:ShellSidebar x:Name="ShellSidebar"
                                   Grid.Column="0"
                                   Canvas.ZIndex="10" />

            <controls:SidebarResizeHandle x:Uid="SidebarResizeHandle"
                                          x:Name="SidebarResizeHandle"
                                          Grid.Column="0"
                                          Canvas.ZIndex="12"
                                          Width="10"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Stretch"
                                          Background="Transparent"
                                          IsTabStop="True"
                                          PointerPressed="SidebarResizeHandle_PointerPressed"
                                          PointerMoved="SidebarResizeHandle_PointerMoved"
                                          PointerReleased="SidebarResizeHandle_PointerReleased"
                                          PointerCanceled="SidebarResizeHandle_PointerCanceled"
                                          PointerCaptureLost="SidebarResizeHandle_PointerCaptureLost"
                                          KeyDown="SidebarResizeHandle_KeyDown"
                                          AutomationProperties.AutomationId="SidebarResizeHandle"
                                          AutomationProperties.Name="Resize sidebar"
                                          AutomationProperties.HelpText="Drag horizontally to resize. Drag left past the minimum to collapse.">
                <controls:SidebarResizeHandle.Template>
                    <ControlTemplate TargetType="controls:SidebarResizeHandle">
                        <controls:SidebarResizeCursorSurface Background="Transparent" />
                    </ControlTemplate>
                </controls:SidebarResizeHandle.Template>
            </controls:SidebarResizeHandle>

            <!-- Both hairlines — title bar → content, and sidebar → content — are one continuous
                 stroke drawn by this Border, so they meet in a rounded corner instead of a square
                 joint. It has to be a Border rather than two Rectangles: a rounded corner needs a
                 rounded *clip* on the page underneath, and every page paints its own opaque
                 background (ChatPage's differs from the others), which would otherwise square the
                 curve straight back off. The wedge outside the arc falls through to this Grid's
                 background, matched to the sidebar and title bar so the curve reads as the content
                 panel's corner rather than a gap. Only the top-left is rounded; the other three
                 corners are the window frame. -->
            <!-- CornerRadius and BorderThickness are the two properties FlowDirection does NOT
                 mirror (unlike Margin, Padding and HorizontalAlignment), so under a right-to-left
                 language this rounded corner would stay on the left while everything around it
                 moved. ApplyFlowDirection swaps both. -->
            <Border x:Name="ContentPanelBorder"
                    Grid.Column="1"
                    CornerRadius="12,0,0,0"
                    BorderThickness="1,1,0,0"
                    BorderBrush="{ThemeResource BorderDefaultBrush}">
                <Frame x:Name="ContentFrame"
                       Background="{ThemeResource AppBackgroundBrush}" />
            </Border>
        </Grid>

        <Grid x:Name="FloatingOverlayLayer"
              Grid.Row="0"
              Grid.RowSpan="2"
              Canvas.ZIndex="100">
            <!-- Full-window modals are created on first use by MainWindow.Overlays.cs. Keeping
                 this host empty on startup avoids constructing every Settings page and running
                 their Loaded I/O before the user opens Settings. -->
            <Border x:Name="FindOverlayPanel"
                    Width="380"
                    MinHeight="36"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,18,152,0"
                    Padding="8,2,4,2"
                    CornerRadius="14"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="True"
                    Visibility="Collapsed">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ic:FluentIcon Grid.Column="0"
                                   Icon="Search"
                                   IconVariant="Regular"
                                   IconSize="Size16"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,2,0" />

                    <TextBox x:Name="FindTextBox" AutomationProperties.AutomationId="FindTextBox"
                             Grid.Column="1"
                             MinWidth="0"
                             BorderThickness="0"
                             Background="Transparent"
                             x:Uid="FindSearch" PlaceholderText="Search chat..."
                             TextChanged="FindTextBox_TextChanged"
                             KeyDown="FindTextBox_KeyDown" />

                    <TextBlock x:Name="FindCounterText"
                               AutomationProperties.AutomationId="FindCounterText"
                               Grid.Column="2"
                               x:Uid="FindCounter"
                               Text="0 / 0 results"
                               FontSize="{StaticResource ProductCaptionFontSize}"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextTertiaryBrush}" />

                    <Button x:Uid="MainFindPrevious" x:Name="PreviousFindButton" AutomationProperties.AutomationId="PreviousFindButton"
                            Grid.Column="3"
                            Style="{StaticResource FindHudButtonStyle}"
                            Click="PreviousFind_Click"
                            AutomationProperties.Name="Previous result"
                            ToolTipService.ToolTip="Previous result (Shift+Enter)">
                        <ic:FluentIcon Icon="ArrowUp"
                                       IconVariant="Regular"
                                       IconSize="Size16"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Button>

                    <Button x:Uid="MainFindNext" x:Name="NextFindButton" AutomationProperties.AutomationId="NextFindButton"
                            Grid.Column="4"
                            Style="{StaticResource FindHudButtonStyle}"
                            Click="NextFind_Click"
                            AutomationProperties.Name="Next result"
                            ToolTipService.ToolTip="Next result (Enter)">
                        <ic:FluentIcon Icon="ArrowDown"
                                       IconVariant="Regular"
                                       IconSize="Size16"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Button>

                    <Button x:Uid="MainFindClose" x:Name="CloseFindButton"
                            AutomationProperties.AutomationId="CloseFindButton"
                            Grid.Column="5"
                            Style="{StaticResource FindHudButtonStyle}"
                            Click="CloseFind_Click"
                            AutomationProperties.Name="Close find"
                            ToolTipService.ToolTip="Close find (Esc)">
                        <ic:FluentIcon Icon="Dismiss"
                                       IconVariant="Regular"
                                       IconSize="Size12"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <Border x:Name="ZoomPopupPanel"
                    Width="236"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Padding="14,6"
                    CornerRadius="18"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="True"
                    Visibility="Collapsed">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ZoomPercentText"
                               Grid.Column="0"
                               Text="100%"
                               FontSize="{StaticResource ProductCaptionFontSize}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Rectangle Grid.Column="1"
                               Width="1"
                               Height="18"
                               Fill="{ThemeResource DividerBrush}"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                    <Button x:Uid="MainZoomOut" Grid.Column="2"
                            Style="{StaticResource ZoomHudButtonStyle}"
                            Click="ActualSizeZoomOut_Click"
                            AutomationProperties.Name="Zoom out"
                            ToolTipService.ToolTip="Zoom out">
                        <TextBlock Text="-"
                                   FontSize="{StaticResource ProductSubtitleFontSize}"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button x:Uid="MainZoomIn" Grid.Column="3"
                            Style="{StaticResource ZoomHudButtonStyle}"
                            Click="ActualSizeZoomIn_Click"
                            AutomationProperties.Name="Zoom in"
                            ToolTipService.ToolTip="Zoom in">
                        <TextBlock Text="+"
                                   FontSize="{StaticResource ProductSubtitleFontSize}"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Rectangle Grid.Column="4"
                               Width="1"
                               Height="18"
                               Fill="{ThemeResource DividerBrush}"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                    <Button x:Name="ResetZoomButton" AutomationProperties.AutomationId="ResetZoomButton"
                            Grid.Column="5"
                            Style="{StaticResource TextActionButtonStyle}"
                            IsEnabled="False"
                            Padding="10,0"
                            MinWidth="0"
                            MinHeight="26"
                            HorizontalAlignment="Stretch"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Click="ResetZoom_Click">
                        <TextBlock x:Uid="ZoomReset" Text="Reset"
                                   FontSize="{StaticResource ProductCaptionFontSize}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Window-wide "you dropped this in the wrong place" hint. Only the composer is a
                 real drop target, so a file dragged anywhere else in the window gets this
                 instead of a silent no-drop cursor. IsHitTestVisible=False so it never
                 intercepts the drag itself. See MainWindow.DragDrop.cs. -->
            <Border x:Name="DragHintPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,60,0,0"
                    Padding="16,10"
                    CornerRadius="20"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BrandPrimaryBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ic:FluentIcon Icon="ArrowDown"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   Foreground="{ThemeResource BrandPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    <TextBlock x:Uid="DropHint" Text="Drop files on the message box to attach"
                               FontSize="{StaticResource ProductBodyFontSize}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Top-most, non-blocking overlay for in-app notification toasts. Must span both rows
             (like SettingsOverlay/FindOverlayPanel) — otherwise it lands in the 36px title-bar
             row and its top-anchored cards are laid out below their slot and never show. -->
        <controls:InAppNotificationHost x:Name="InAppNotifications"
                                        Grid.Row="0" Grid.RowSpan="2" Canvas.ZIndex="1000" />
    </Grid>
</Window>
