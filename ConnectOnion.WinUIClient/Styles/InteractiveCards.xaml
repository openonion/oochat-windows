<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <CornerRadius x:Key="InteractiveCardCornerRadius">10</CornerRadius>
    <Thickness x:Key="InteractiveCardPadding">16</Thickness>
    <x:Double x:Key="InteractiveCardSpacing">12</x:Double>
    <x:Double x:Key="InteractiveControlMinHeight">40</x:Double>
    <Style x:Key="InteractiveCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ProductBodyFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="InteractiveCardSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ProductCaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="InteractiveCardBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ProductMicroFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="InteractiveCardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource InteractiveControlMinHeight}" />
        <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style x:Key="InteractiveCardPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource InteractiveControlMinHeight}" />
        <Setter Property="Padding" Value="16,6" />
    </Style>
    <Style x:Key="InteractiveCardTertiaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TextActionButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource InteractiveControlMinHeight}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style x:Key="InteractiveFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ProductCaptionFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="InteractiveHelperTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ProductMicroFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
