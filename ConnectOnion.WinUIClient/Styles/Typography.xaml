<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Bundled under the SIL Open Font License; see Assets/Fonts/OFL.txt. -->
    <FontFamily x:Key="JetBrainsMonoFontFamily">ms-appx:///Assets/Fonts/JetBrainsMonoNerdFontMono-Regular.ttf#JetBrainsMono NFM</FontFamily>
    <FontFamily x:Key="JetBrainsMonoItalicFontFamily">ms-appx:///Assets/Fonts/JetBrainsMonoNerdFontMono-Italic.ttf#JetBrainsMono NFM</FontFamily>
    <FontFamily x:Key="JetBrainsMonoBoldFontFamily">ms-appx:///Assets/Fonts/JetBrainsMonoNerdFontMono-Bold.ttf#JetBrainsMono NFM</FontFamily>
    <FontFamily x:Key="JetBrainsMonoBoldItalicFontFamily">ms-appx:///Assets/Fonts/JetBrainsMonoNerdFontMono-BoldItalic.ttf#JetBrainsMono NFM</FontFamily>

    <!-- Compact product type ramp. These doubles work on TextBlock, Control-derived elements,
         icon glyphs, and code surfaces; page XAML must reference a role instead of embedding a
         numeric FontSize. Segoe UI Variable remains the platform default. -->
    <x:Double x:Key="ProductMicroFontSize">11</x:Double>
    <x:Double x:Key="ProductCaptionFontSize">12</x:Double>
    <x:Double x:Key="ProductCodeFontSize">13</x:Double>
    <x:Double x:Key="ProductBodyFontSize">14</x:Double>
    <x:Double x:Key="ProductSubtitleFontSize">16</x:Double>
    <x:Double x:Key="ProductSectionTitleFontSize">20</x:Double>
    <x:Double x:Key="ProductTitleFontSize">24</x:Double>
    <x:Double x:Key="ProductHeroFontSize">28</x:Double>

    <Style x:Key="ProductCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ProductCaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>
    <Style x:Key="ProductBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ProductBodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="ProductBodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ProductBodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ProductSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ProductSubtitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="ProductTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ProductTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>
</ResourceDictionary>
