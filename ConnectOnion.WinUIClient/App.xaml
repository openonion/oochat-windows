<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ConnectOnion.WinUIClient.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectOnion.WinUIClient"
    xmlns:presentation="using:ConnectOnion.WinUIClient.Presentation">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Colors.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Brushes.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Typography.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/ControlStyles.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/InteractiveCards.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The workspace and composer share one 920px operational track. Long-form agent
                 prose uses the narrower reading measure, while tool timelines, approvals, diffs
                 and the composer keep the full track for structured content. All values are caps,
                 not fixed widths, so narrow windows still reflow without horizontal page scroll. -->
            <x:Double x:Key="ChatColumnWidth">920</x:Double>
            <x:Double x:Key="ChatReadingWidth">760</x:Double>
            <x:Double x:Key="ChatComposerWidth">920</x:Double>
            <x:Double x:Key="AgentLibraryWidth">1120</x:Double>
            <x:Double x:Key="Spacing4">4</x:Double>
            <x:Double x:Key="Spacing8">8</x:Double>
            <x:Double x:Key="Spacing12">12</x:Double>
            <x:Double x:Key="Spacing16">16</x:Double>
            <x:Double x:Key="Spacing20">20</x:Double>
            <x:Double x:Key="Spacing24">24</x:Double>
            <x:Double x:Key="Spacing32">32</x:Double>
            <x:Double x:Key="SidebarPrimaryRowHeight">40</x:Double>
            <x:Double x:Key="SidebarSecondaryRowHeight">36</x:Double>
            <Thickness x:Key="PageMarginNarrow">16,16,16,28</Thickness>
            <Thickness x:Key="PageMarginDefault">32,24,32,36</Thickness>
            <Thickness x:Key="PageMarginWide">48,28,48,40</Thickness>
            <Thickness x:Key="SettingsContentMargin">28,6,28,28</Thickness>
            <Thickness x:Key="SettingsHeaderPadding">28,20,20,14</Thickness>
            <Thickness x:Key="AgentDetailPaddingNarrow">16,12,16,12</Thickness>
            <Thickness x:Key="AgentDetailPaddingWide">24,20,24,20</Thickness>
            <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
            <CornerRadius x:Key="CornerRadiusControl">8</CornerRadius>
            <CornerRadius x:Key="CornerRadiusSurface">12</CornerRadius>

            <presentation:BoolToVisibilityConverter x:Key="BoolToVis" />
            <presentation:StringToVisibilityConverter x:Key="StringToVis" />
            <presentation:PresenceToBrushConverter x:Key="PresenceToBrush" />
            <presentation:EventStatusToBrushConverter x:Key="EventStatusToBrush" />
            <presentation:InteractiveStatusToBrushConverter x:Key="InteractiveStatusToBrush" />
            <presentation:InteractiveToneToBrushConverter x:Key="InteractiveToneToBrush" />
            <presentation:BoolToResourceBrushConverter x:Key="BoolToResourceBrush" />
            <presentation:ConnectionPhaseToBrushConverter x:Key="ConnectionPhaseToBrush" />
            <presentation:DiffTextToLinesConverter x:Key="DiffTextToLines" />
            <presentation:DiffKindToBrushConverter x:Key="DiffKindToBrush" />
            <presentation:ToolStatusToBrushConverter x:Key="ToolStatusToBrush" />
            <presentation:ToolIconConverter x:Key="ToolIcon" />
            <presentation:ToolStatusToIconConverter x:Key="ToolStatusToIcon" />
            <presentation:ApprovalTargetKindToIconConverter x:Key="ApprovalTargetIcon" />
            <presentation:ResourceStyleConverter x:Key="ResourceStyle" />
            <presentation:IconNameConverter x:Key="IconName" />
            <presentation:BoolToThicknessConverter x:Key="BoolToThickness" />
            <presentation:LocalPathToImageSourceConverter x:Key="PathToImage" />
            <presentation:RowStateToBackgroundConverter x:Key="RowStateToBackground" />
            <presentation:BoolToFontWeightConverter x:Key="BoolToFontWeight" />

            <!-- An app-resolvable transparent brush, so a BoolToResourceBrush binding can pick
                 "no fill" for its false case by key (the converter indexes Application.Current
                 .Resources directly, which does not reliably surface framework system brushes). -->
            <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
            <presentation:HeatmapLevelToBrushConverter x:Key="HeatmapLevelToBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
